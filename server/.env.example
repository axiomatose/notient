# Notient API: copy to .env (server/.env for `npm start`, repo-root .env for Docker Compose).
# Never commit the real file.

# --- Required in production -------------------------------------------------
# Signs session tokens. Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Encrypts stored credentials (CalDAV passwords), 32+ characters. Generate: openssl rand -hex 32
# Changing it later makes existing encrypted values unreadable.
ENCRYPTION_MASTER_KEY=change-me-to-32-or-more-random-characters

# --- Network ----------------------------------------------------------------
HOST=0.0.0.0
PORT=3301
# The address clients use to reach this server (builds image URLs, is allowed by CORS).
PUBLIC_URL=https://notes.example.com
# Extra browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=https://notes.example.com
# Where the built web app lives, if this server should serve it (see README, "Self-hosting").
# WEB_DIST=/web

# --- Storage ----------------------------------------------------------------
# One folder holds the SQLite database, notes (Markdown files) and uploads.
DATA_DIR=./data
# DB_PATH=./data/app.db
# SQLITE_JOURNAL_MODE=WAL

# --- Sessions and limits ----------------------------------------------------
JWT_EXPIRES_IN=12h
DEVICE_MAX_AGE_MS=2592000000
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5
# Requests per IP per window across every route.
# API_RATE_MAX=1000

# --- Web push (optional) ----------------------------------------------------
# Generate a pair: npm run vapid-generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
# Allow calendar subscriptions to fetch private/LAN addresses (off by default).
# NOTIENT_ALLOW_LOCAL_FEEDS=true
