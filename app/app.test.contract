test "a finished card dropped inside the Done column stays where it was"
  type "email" "done2@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  tap "submit-auth"
  clock data
  clock settle
  tap "tab-tasks"
  clock settle
  tap "new-list-button"
  clock settle
  type "edit-list-name" "Ship"
  tap "edit-list-save"
  clock data
  clock settle
  tap "Ship"
  clock data
  clock settle
  tap "list-menu"
  clock settle
  tap "menu-add-section"
  clock settle
  type "section-draft" "Done"
  tap "add-section"
  clock data
  clock settle
  tap "list-fab-add-task"
  clock settle
  type "list-quick-title" "Pack"
  type "list-quick-title" key "Enter"
  clock data
  clock settle
  type "list-quick-title" "Label"
  type "list-quick-title" key "Enter"
  clock data
