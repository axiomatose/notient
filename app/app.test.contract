test "a task carries notes, a due date, priority, tags and subtasks"
  type "email" "ted@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  tap "submit-auth"
  clock data
  clock settle
  tap "tab-tasks"
  clock settle
  tap "new-list-button"
  clock settle
  type "edit-list-name" "Home repairs"
  tap "edit-list-save"
  clock data
  clock settle
  tap "Home repairs"
  clock data
  clock settle
  tap "list-fab-add-task"
  type "list-quick-title" "Fix the sink"
  type "list-quick-title" key "Enter"
  clock data
  clock settle
  tap "Open Fix the sink"
  clock data
  clock settle
  type "task-note-draft" "# Steps"
  tap "task-note-add"
  clock data
  clock settle
  expect state taskNotes.notes.0 .body == "# Steps"
  clock data
  clock settle
  expect state tasks.tasks.0 .latestBody == "# Steps"
  tap "task-date-toggle"
  clock settle
  type "task-due" "2026-11-20"
  type "task-priority" "3"
  type "task-tags" "plumbing, weekend"
  tap "task-done"
  clock data
  clock settle
  expect state tasks.tasks.0 .priority == 3
  expect state tasks.tasks.0 .tags.0 == "plumbing"
  tap "Open Fix the sink"
  clock data
  clock settle
  type "subtask-draft" "Buy parts"
  tap "add-subtask"
  clock data
  clock settle
  expect state subtasks.tasks.0 .title == "Buy parts"
  tap "Check off Buy parts"
  clock data
  clock settle
  expect state subtasks.tasks.0 .isDone == true
  expect tree missing "task-reorder-header"
  expect tree missing "task-up"
  expect tree missing "task-down"
  tap "Buy parts"
  clock settle
  type "Rename Buy parts" "Buy gaskets"
  type "Rename Buy parts" key "Enter"
  clock data
  clock settle
  expect state subtasks.tasks.0 .title == "Buy gaskets"
  tap "Delete Buy gaskets"
  clock settle
  tap "subtask-delete-confirm"
  clock data
  clock settle
  expect state subtasks.tasks == []
  expect state tasks.tasks.0 .subtaskCount == 0
  tap "task-delete"
  clock settle
  tap "delete-task-confirm"
  clock data
  clock settle
  expect state tasks.tasks == []

