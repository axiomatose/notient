test "a task's right-click menu flags, prioritises, completes and deletes it"
  type "email" "ctx1@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  tap "submit-auth"
  clock data
  clock settle
  tap "tab-tasks"
  clock settle
  tap "new-list-button"
  clock settle
  type "edit-list-name" "Menus"
  tap "edit-list-save"
  clock data
  clock settle
  tap "Menus"
  clock data
  clock settle
  tap "list-fab-add-task"
  clock settle
  type "list-quick-title" "Sweep"
  type "list-quick-title" key "Enter"
  clock data
  clock settle
  tap "Sweep" contextmenu
  clock settle
  tap "ctx-flag"
  clock data
  clock settle
  expect state tasks.tasks.0 .flagged == true
  tap "Sweep" contextmenu
  clock settle
  tap "grp-prio"
  tap "ctx-priority-3"
  clock data
  clock settle
  expect state tasks.tasks.0 .priority == 3
  tap "Sweep" contextmenu
  clock settle
  tap "ctx-done"
  clock data
  clock settle
  expect state tasks.tasks.0 .isDone == true
  tap "Sweep" contextmenu
  clock settle
  tap "ctx-delete"
  clock settle
  tap "ctx-delete-cancel"
  clock settle
  expect state tasks.tasks.length == 1
  tap "Sweep" contextmenu
  clock settle
  tap "ctx-delete"
  clock settle
  tap "ctx-delete-confirm"
  clock data
  clock settle
  expect state tasks.tasks.length == 0

