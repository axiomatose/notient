  tap "drawer-grabber"
  clock settle
  expect tree missing "drawer"
  tap "Open Sweep"
  clock settle
  type "task-title" "Sweep up"
  tap "task-done"
  clock data
  clock settle
  expect tree missing "drawer"
  expect state tasks.tasks.0 .title == "Sweep up"

