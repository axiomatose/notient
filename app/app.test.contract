test "an event lands on its day"
  epoch "2026-11-16T08:00:00Z"
  type "email" "erin@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  tap "submit-auth"
  clock data
  clock settle
  tap "tab-calendar"
  clock data
  clock settle
  tap "fab-add-event"
  clock settle
  type "event-title" "Dentist"
  type "event-start-day" "2026-11-16"
  type "event-start-time" "09:30"
  tap "new-event-add"
  clock data
  clock settle
  tap "cell-2026-11-16"
  clock data
  clock settle
  expect state activeDay == "2026-11-16"
  expect state selectedCell.events.0 .title == "Dentist"
  tap "open-day"
  clock data
  clock settle
  expect state calMode == "day"
  expect state dayEvents.0 .title == "Dentist"

