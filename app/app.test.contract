  expect text "board-count-none" == "0"
  // Pack finished first, Label after it: a drop inside Done sends nothing, so Pack is not re-stamped.
  tap "Hold and drag Pack to reorder" drag to "Hold and drag Label to reorder"
  clock settle
  clock data
  clock settle
  expect state tasks.tasks.0 .title == "Pack"
  expect state tasks.tasks.1 .completedAt >= state tasks.tasks.0 .completedAt

