test "the sign-in page lets a self-hoster set the server address"
  expect tree has "server-toggle"
  expect tree missing "server-input"
  tap "server-toggle"
  clock settle
  expect tree has "server-input"
  type "server-input" "not an address"
  tap "server-save"
  clock data
  clock settle
  expect tree has "server-error"
  type "server-input" "https://notes.example.com/"
  tap "server-save"
  clock data
  clock settle
  expect tree has "auth-logo"
  expect text "server-toggle" == "Server: https://notes.example.com"
  // Saving tucks the panel away, leaving just the chosen server.
  expect tree missing "server-input"

test "a server typed once is kept and can be picked again, with the default"
  tap "server-toggle"
  clock settle
  type "server-input" "https://one.example.com"
  tap "server-save"
  clock data
  clock settle
  expect tree missing "server-input"
  expect text "server-toggle" == "Server: https://one.example.com"
  tap "server-toggle"
  clock settle
  expect tree has "server-choice-default"
  expect tree has "server-choice-https://one.example.com"
  type "server-input" "https://two.example.com"
  tap "server-save"
  clock data
  clock settle
  expect text "server-toggle" == "Server: https://two.example.com"
  tap "server-toggle"
  clock settle
  expect tree has "server-choice-https://one.example.com"
  expect tree has "server-choice-https://two.example.com"
  tap "server-choice-https://one.example.com"
  clock data
  clock settle
  expect tree missing "server-input"
  expect text "server-toggle" == "Server: https://one.example.com"
  tap "server-toggle"
  clock settle
  tap "server-choice-default"
  clock data
  clock settle
  expect text "server-toggle" == "Use your own server"

test "the calendar button heads for today, then out to the month, then rests"
  type "email" "caltoday1@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  tap "submit-auth"
  clock data
  clock settle
  tap "tab-calendar"
  clock data
  clock settle
  tap "cal-menu"
  clock settle
  tap "cal-mode-day"
  clock data
  clock settle
  tap "next-period"
  clock data
  clock settle
  expect state periodOffset == 1
  tap "today-button"
  clock data
  clock settle
  expect state periodOffset == 0
  expect state calMode == "day"
  tap "today-button"
  clock data
  clock settle
  expect state calMode == "month"
  tap "next-period"
  clock data
  clock settle
  tap "today-button"
  clock data
  clock settle
  expect state periodOffset == 0
  expect state calMode == "month"
  tap "today-button"
  clock data
  clock settle
  expect state periodOffset == 0
  expect state calMode == "month"

