// The app talks to the repo's Express API; `test` and `verify` start server.ts
// on an empty database for the whole run, so the tests share it in order.
// Each test starts from empty storage (signed out), so it signs up its own
// account; rows carry server-made ids, so they are driven by their text.
test "sign up straight into the notes list"
  expect tree has "email"
  type "email" "alex@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  type "name" "Alex"
  tap "submit-auth"
  clock data
  clock settle
  expect state shown == "Alex"
  expect tree has "empty-add-note"

test "a note is written, opened, edited, filed, tagged, trashed and restored"
  type "email" "blake@example.com"
  type "password" "Passw0rd!23"
  tap "toggle-auth"
  clock settle
  type "name" "Blake"
  tap "submit-auth"
  clock data
  clock settle
  tap "notes-add"
  tap "add-note"
  clock settle
  type "note-title" "Grocery plan"
  type "note-body" "Buy oats and milk"
  tap "note-save"
  clock data
  clock settle
  expect state lib.notes.0 .title == "Grocery plan"
  tap "Grocery plan"
  clock data
  clock settle
  expect text "note-title-display" == "Grocery plan"
  expect state editorBody == "Buy oats and milk"
  tap "note-title-display"
  clock settle
  type "note-title" "Grocery plan v2"
  tap "note-title-done"
  clock settle
  tap "note-folder-button"
  clock settle
  type "note-folder" "Lists"
  tap "note-tags-button"
  clock settle
  type "note-tags" "shopping, weekly"
  tap "note-pin"
  tap "note-edit"
  clock settle
  tap "note-save"
  clock data
  clock settle
  expect state lib.notes.0 .title == "Grocery plan v2"
  expect state lib.notes.0 .folder == "Lists"
  expect state lib.notes.0 .isPinned == true
  expect state lib.notes.0 .tags.0 == "shopping"
  expect state lib.notes.0 .tags.1 == "weekly"
  back
  clock settle
  tap "tab-search"
  clock settle
  type "search-sheet-input" "weekly"
  clock data
  clock settle
  expect state found.notes.length == 1
  tap "search-sheet-close"
  clock settle
  tap "open-trash"
  clock settle
  expect text "trash-empty" == "Nothing in the trash."
  back
  clock settle
  tap "Grocery plan v2"
  clock data
  clock settle
  tap "note-trash"
  clock settle
  tap "trash-confirm"
  clock data
  clock settle
  expect state lib.notes.0 .deletedAt == 1
  tap "open-trash"
  clock settle
  expect tree missing "trash-empty"
  tap "Restore"
  clock data
  clock settle
  expect state lib.notes.0 .deletedAt == 0
  back
  clock settle
  tap "Grocery plan v2"
  clock data
  clock settle
  tap "note-trash"
  clock settle
  tap "trash-confirm"
  clock data
  clock settle
  tap "open-trash"
  clock settle
  tap "Delete Grocery plan v2 forever"
  clock settle
  tap "forever-confirm"
  clock data
  clock settle
  expect state lib.notes == []

