// Notient: notes, tasks and a calendar over the repo's Express API (app.ts).
// Controls, bars and the sidebar are the platform's: a root tablist is the iOS
// tab bar and a wide window's sidebar; a list whose rows push shows its detail
// beside it when wide. Who is signed in is the bar button the menu opens.
use EmptyState from "exact:content"

routes nav
  tab notes "/"
    note "/note/:id"
    newNote "/new"
    trash "/trash"
    share "/share/:id"
    sharedNote "/shared/:id"
    publicNote "/public/:slug"
    settings "/settings"
    privacy "/privacy"
    terms "/terms"
  tab tasks "/tasks"
    taskList "/tasks/:id"
    editList "/edit-list/:id"
    taskDetail "/task/:id"
    shareList "/share-list/:id"
    newTask "/new-task"
    newList "/new-list"
    newSection "/new-section"
  tab calendar "/calendar"
    newEvent "/new-event"
    eventDetail "/event/:id"
    manageCalendars "/manage-calendars"
    addCalendar "/add-calendar"
  tab search "/search"

shape Time
  epochAtZero: number
  utcOffset: number

shape Session
  signedIn: bool
  name: string
  email: string

shape Reply
  ok: bool
  error: string

shape Note
  id: string
  title: string
  body: string
  isPinned: bool
  tags: string[]
  folder: string
  updatedAt: number
  deletedAt: number
  version: number

shape Notes
  owner: string
  notes: Note[]
  folders: string[]
  tags: string[]
  stale: bool

shape ShareLink
  id: string
  slug: string

shape NoteLinks
  owner: string
  links: ShareLink[]

shape LinkReply
  ok: bool
  url: string
  error: string

shape Share
  id: string
  email: string
  permission: string

shape NoteShares
  owner: string
  shares: Share[]

shape SharedNote
  id: string
  title: string
  body: string
  sharedBy: string

shape Shared
  owner: string
  notes: SharedNote[]

shape CodeToken
  i: number
  t: string
  k: string

shape CodeBlock
  text: string
  tokens: CodeToken[]

shape CodeHighlights
  blocks: CodeBlock[]

shape PublicNote
  found: bool
  title: string
  body: string

shape CreatedNote
  ok: bool
  error: string
  id: string
  title: string
  body: string

shape ImportReply
  ok: bool
  imported: number
  skipped: number
  error: string

shape ExportReply
  ok: bool
  path: string
  name: string
  error: string
  count: number
  skipped: number

shape ImageReply
  ok: bool
  url: string
  error: string

shape TaskList
  id: string
  name: string
  folderId: string
  icon: string
  color: string
  uncategorizedName: string
  grocery: bool
  viewMode: string

shape TaskLists
  owner: string
  lists: TaskList[]

shape Task
  id: string
  title: string
  isDone: bool
  notes: string
  dueAt: number
  dueDay: string
  dueTime: string
  dueHasTime: bool
  remindAt: number
  flagged: bool
  recurrence: string
  url: string
  priority: number
  tags: string[]
  sectionId: string
  version: number
  sortOrder: number
  subtaskCount: number
  latestBody: string
  latestBy: string
  latestAt: number
  parentId: string
  assigneeId: string
  completedAt: number

shape Member
  id: string
  role: string
  name: string
  email: string
  icon: string
  color: string
  photo: string

shape TemplateItem
  id: string
  name: string
  blurb: string
  builtin: bool
  title: string
  body: string
  json: string

shape FoundNote
  id: string
  title: string
  sub: string

shape FoundTask
  id: string
  title: string
  listId: string
  sub: string
  done: bool

shape FoundEvent
  id: string
  title: string
  sub: string

shape FoundPlace
  id: string
  title: string
  sub: string

shape Found
  q: string
  notes: FoundNote[]
  tasks: FoundTask[]
  events: FoundEvent[]
  folders: FoundPlace[]
  lists: FoundPlace[]

shape Templates
  owner: string
  notes: TemplateItem[]
  lists: TemplateItem[]

shape ListMade
  ok: bool
  error: string
  id: string

shape Members
  owner: string
  listId: string
  members: Member[]

shape Tasks
  owner: string
  listId: string
  tasks: Task[]

shape RecentTask
  id: string
  title: string
  listId: string

shape RecentTasks
  owner: string
  tasks: RecentTask[]

shape RecentEvents
  owner: string
  events: EventRow[]

shape ReorderReply
  owner: string
  listId: string
  order: string[]

// One note on a task: its text, who wrote it and when.
shape TaskNote
  id: string
  body: string
  createdAt: number
  userId: string
  name: string
  email: string
  icon: string
  color: string
  photo: string

shape TaskNotes
  owner: string
  taskId: string
  notes: TaskNote[]

shape Subtasks
  owner: string
  parentId: string
  tasks: Task[]

shape BoardSubtasks
  owner: string
  listId: string
  tasks: Task[]

shape Section
  id: string
  name: string
  icon: string
  color: string
  tasks: Task[]

shape IconPaths
  name: string
  paths: string[]

shape IconNames
  names: string[]

shape Sections
  owner: string
  listId: string
  sections: Section[]

shape TaskFolder
  id: string
  name: string

shape TaskFolders
  owner: string
  folders: TaskFolder[]

shape ListShares
  owner: string
  shares: Share[]

shape Live
  status: string
  ticks: number
  text: string

shape SharedList
  id: string
  name: string
  sharedBy: string
  permission: string
  icon: string
  color: string
  uncategorizedName: string
  grocery: bool
  viewMode: string

shape SharedLists
  owner: string
  lists: SharedList[]

shape NotificationItem
  id: string
  type: string
  title: string
  message: string
  isRead: bool
  createdAt: number
  resourceId: string
  resourceType: string
  listId: string

shape Notifications
  owner: string
  items: NotificationItem[]

shape Attachment
  id: string
  url: string

shape Attachments
  owner: string
  taskId: string
  items: Attachment[]

shape EventRow
  id: string
  title: string
  time: string
  location: string
  description: string
  calendarId: string
  allDay: bool
  startTime: number
  endTime: number
  recurrence: string
  attendees: string[]
  startMin: number
  endMin: number
  lane: number
  lanes: number
  startDay: string
  startClock: string
  endDay: string
  endClock: string
  url: string
  alertMinutes: number
  dayShort: string

shape Cell
  day: string
  label: string
  heading: string
  inPeriod: bool
  isToday: bool
  events: EventRow[]

shape CalendarView
  owner: string
  periodLabel: string
  cells: Cell[]

shape CalendarItem
  id: string
  name: string
  color: string
  isActive: bool
  type: string
  // "" for an own calendar; "ics" (web link) or "caldav" (account) for a read-only subscription.
  syncKind: string
  syncError: string

// A CalDAV account's calendars, as found.
shape FoundCalendar
  url: string
  name: string
  color: string

shape Discovery
  ok: bool
  error: string
  found: FoundCalendar[]

shape Calendars
  owner: string
  calendars: CalendarItem[]

// The signed-in person's profile: the name shown, the photo's url ("" for none), and the icon and color that stand in for it.
shape Profile
  owner: string
  displayName: string
  avatarUrl: string
  avatarIcon: string
  avatarColor: string

// The appearance the person chose: "auto" (follow the system), "light" or "dark".
shape ServerAddress
  server: string
  fallback: string
  saved: string[]

// Where the app is talking and whether that works: state "ok" (answered, and the token is good), "auth" (answered, the token was refused),
// "down" (no answer), "error" (another answer).
shape ServerCheck
  host: string
  state: string

shape AuthOptions
  registration: bool
  demoEmail: string
  demoPassword: string

shape Prefs
  appearance: string
  boards: string

shape ViewBlock
  kind: string
  text: string
  index: number
  checked: bool
  indent: number

// One run of a link line: link text (href set) or plain text between links.
shape Span
  k: string
  text: string
  href: string

shape BundledIcon
  name: string
  paths: string[]

