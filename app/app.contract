                        image "symbol:ellipsis"
                    input hatch="ai" data-request=aiRequest value=aiValue input=aiInput aria-hidden=true testId="ai-bridge" position="absolute" width="0.1rem" height="0.1rem" opacity=0 pointer-events="none" outline="none"
