                            row gap=8 align-items="center" width="100%"
                              text "Assign to" flex=1 min-width=0 text-align="start"
                              text (ctxRow.assigneeId == "" ? "Unassigned" : memberList.filter(m => m.id == ctxRow.assigneeId).map(m => m.name).join("")) color="-exact-secondary-label" font="-exact-footnote" line-clamp=1
