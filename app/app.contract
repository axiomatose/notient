                                      column gap=2 padding="10px 10px 2px" border-radius=10 background-color="light-dark(#fff, #2c2c2e)" width="100%" box-sizing="border-box" aria-label=`Hold and drag ${tk.title} to reorder` testId=`board-grip-${tk.id}` contextPopover="task-menu" contextmenu=openTaskMenu(tk.id)
                                        BoardCardBody(tk=tk, todayMs=todayMs, today=today, offset=time.utcOffset, members=memberList, subs=(boardSubtasks.listId == openList ? boardSubtasks.tasks.filter(s => s.parentId == tk.id) : []), toggle=toggleTask, open=openTaskDetail)
                                        view reorderFor=`board-list-${col}` touch-action="none" aria-label=`Hold and drag ${tk.title} to reorder` testId=`board-grip-${tk.id}` width="100%" height=24 flex-shrink=0 display="flex" align-items="center" justify-content="center"
