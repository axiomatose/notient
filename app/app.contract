                                  text `${colTasks(tasks.tasks, col, doneSectionId, "").length}` testId=`board-count-${col}` color="-exact-secondary-label" font="-exact-caption2"
                                  view position="relative" width=24 height="9rem" flex-shrink=0 overflow="hidden"
                                    text boardName(sections.sections, noneName, col) position="absolute" left=-60 top=60 width="9rem" height=24 line-clamp=1 text-align="start" font="-exact-subheadline" color=colorOr(sectionOf(sections.sections, col).color) transform="rotate(90deg)" aria-hidden=true
                                // Between the name and the plus the sliver is a drop zone: an empty list in the board's group (no rows, so nothing is drawn).
