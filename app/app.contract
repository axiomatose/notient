  action addTaskImage(taskId: string, name: string, path: string, mime: string)
    send taskImageR = uploadTaskImage(taskId, name, path, mime)
  // Done is ordered by completion time, so a card dropped back inside Done has nowhere new to go: nothing is sent and
  // the host returns it to where it was (a placeTask would only write a sort order the column ignores).
  action dropTask(key: string, before: option<string>, e: ReorderEvent)
    if doneSectionId == "" or boardSection(e.from) != doneSectionId or boardSection(e.to) != doneSectionId
      send taskDropped = placeTask(openList, key, boardSection(e.to), orEmpty(before), doneSectionId == "" ? "" : boardSection(e.to) == doneSectionId ? "done" : "open")
  action dropSection(key: string, before: option<string>)
    send sectionMoved = placeSection(openList, key, orEmpty(before))
  action openSectionOrder
    hidePopover("list-menu-pop")
    reorderingSections = true
  action closeSectionOrder
    reorderingSections = false
