                                        input type="checkbox" checked=tk.isDone change=toggleTask(tk.id) aria-label=`Check off ${tk.title}` testId=`task-${tk.id}` outline="none"
                                        button press=openTaskDetail(tk.id) testId=`task-title-${tk.id}` flex=1 min-width=0 text-align="start"
                                          text tk.title color="-exact-secondary-label"
