    sideNotesOpen = not sideNotesOpen
  action toggleSideNotesTall
    sideNotesTall = not sideNotesTall
  action toggleSideTasks
    sideTasksOpen = not sideTasksOpen
  action toggleSideTasksTall
    sideTasksTall = not sideTasksTall
