      if dropOver and wide
        column position="absolute" inset=12 z-index=60 align-items="center" justify-content="center" gap=6 border="3px dashed AccentColor" border-radius=18 background-color="light-dark(#ffffffd9, #000000d9)" pointer-events="none" testId="drop-overlay"
