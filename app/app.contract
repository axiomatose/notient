    subDelete = ""
  action reorderTasksNow(dragged: string, before: string)
    send taskReordered = reorderTasks(openList, dragged, before)
  action postTaskNote(taskId: string, body: string)
    if body.trim() != ""
      send taskNoteAdded = addTaskNote(taskId, body.trim())
  action dropTaskNote(taskId: string, noteId: string)
