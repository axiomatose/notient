                            button press=exportShown aria-label=(folderFilter != "" ? "Export Folder…" : "Export All Notes…") -exact-menu="file" disabled=pending(exportMade) testId="export-notes-pane"
                              row gap=6 align-items="center"
                                LucideIcon(paths=["M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4", "m7 10 5 5 5-5", "M12 15V3"], color="-exact-label", size=16)
                                text "Export"
                            button press=openNewNote buttonStyle="filled" testId="pane-add-note"
                              text "New Note"
                          row flex-wrap="wrap" gap=12
                            for n in sideNotes.slice(0, 6) key=n.id
                              button press=openSideNote(n.id) appearance="none" testId=`pane-note-${n.id}` flex="1 1 17rem" max-width="28rem" box-sizing="border-box" padding=16 border-radius=12 background-color="light-dark(#f2f2f7, #2c2c2e)" text-align="start" display="flex" flex-direction="column" gap=6 contextPopover="note-menu" contextmenu=openNoteMenu(n.id)
                                text (n.title.trim() == "" ? "Untitled" : n.title) font="-exact-headline" line-clamp=1
                                text (isVault(n.tags) ? "Vault note" : previewOf(n.body) == "" ? "No text yet." : previewOf(n.body)) font="-exact-subheadline" color="-exact-secondary-label" line-clamp=3
                          TemplateRow(label="Start from a template", kind="note", items=templates.notes, use=openNoteFromTemplate, useList=newListFromTemplate, remove=askDeleteTemplate)
                else
                  column navigationKey=`${e.id}` navigationBar=(wide ? "none" : "auto") box-sizing="border-box" padding-top=(wide ? 44 : 0) navigationScroll=`content-${e.id}` position="absolute" inset=0
