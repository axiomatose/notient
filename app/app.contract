                                          image "symbol:forward-chevron" width=14 height=14 transform=(folded(foldedCols, col) ? "rotate(0deg)" : "rotate(90deg)")
                                    if sectionRenameError != "" and sectionRenaming == col and not pending(sectionRenamed)
