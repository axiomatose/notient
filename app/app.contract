  action toggleSubtask(id: string, done: bool)
    send subtaskDone = setTaskDone(id, done)
  // A subtask's rename PATCHes the same task fields the editor saves; listId is the parent's list.
  action renameSubtask(id: string, title: string, notes: string, url: string, dueDay: string, dueTime: string, reminder: string, recurrence: string, flagged: bool, priority: number, tags: string[], sectionId: string)
    if not pending(subtaskRenamed)
      send subtaskRenamed = updateTask(id, title, notes, url, dueDay, dueTime, reminder, recurrence, flagged, priority, tags, openList, sectionId)
  action deleteSubtask(id: string)
