              EventEditor(route=0, ev=blankEvent, creating=true, initialDay=activeDay, today=today, nowMs=todayMs, offset=time.utcOffset, calendars=calendars.calendars, save=saveEvent, remove=askDeleteEvent, cancel=closeSheet, error=eventError, saving=(pending(eventAdded)))
            if sheet == "newTask"
              TaskEditor(route=0, task=blankTask, creating=true, listId=newTaskListId, lists=lists.lists, sections=sections.sections, members=[], assign=assignTaskNow, saveClose=createNewTask, wide=wide, drawer=false, zoom=openLightbox, subs=[], images=[], save=createNewTask, trash=askDeleteTask, cancel=closeSheet, addSubtask=addSubtask, toggleSubtask=toggleSubtask, renameSubtask=renameSubtask, removeSubtask=deleteSubtask, addImage=addTaskImage, error=newTaskError, saving=(pending(newTaskAdded)), offset=time.utcOffset, today=today, noteRows=[], me=session.email, todayMs=todayMs, fetched=fetchedIcons, postNote=postTaskNote, dropNote=dropTaskNote)
      row role="tablist" testId="tabs" display=(wide ? "none" : "flex") padding-bottom="calc(env(safe-area-inset-bottom) + 6px)"
        button role="tab" aria-controls="panel-notes" aria-selected=(nav.tab == "notes") press=pick("notes")
          testId="tab-notes" flex=1
          image "symbol:document"
          text "Notes" font-size="min(-exact-subheadline, 31px)"
        button role="tab" aria-controls="panel-tasks" aria-selected=(nav.tab == "tasks") press=pick("tasks")
          testId="tab-tasks" flex=1
          image "symbol:list"
          text "Tasks" font-size="min(-exact-subheadline, 31px)"
        button role="tab" aria-controls="panel-calendar" aria-selected=(nav.tab == "calendar") press=pick("calendar")
          testId="tab-calendar" flex=1
          image "symbol:calendar"
          text "Calendar" font-size="min(-exact-subheadline, 31px)"
        button role="tab" aria-controls="panel-search" aria-selected=false press=openSearchSheet
          testId="tab-search" flex=1
          image "symbol:search"
          text "Search" font-size="min(-exact-subheadline, 31px)"
      column id="tag-menu" popover="auto" role="menu" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="tag-menu"
        button role="menuitem" press=setTagFilter("") popovertarget="tag-menu" popovertargetaction="hide" testId="tag-all"
          text "All tags"
        for tg in lib.tags key=tg
          button role="menuitem" press=setTagFilter(tg) popovertarget="tag-menu" popovertargetaction="hide" testId=`tag-${tg}`
            text tg
      column id="folder-menu" popover="auto" role="menu" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="folder-menu"
        button role="menuitem" press=setFolderFilter("") popovertarget="folder-menu" popovertargetaction="hide" testId="folder-all"
          text "All folders"
        for f in lib.folders key=f
          button role="menuitem" press=setFolderFilter(f) popovertarget="folder-menu" popovertargetaction="hide" testId=`folder-menu-${f}`
            text lastSegment(f) padding-left=(folderDepth(f) * 14)
      column id="sort-menu" popover="auto" role="menu" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="sort-menu"
        button role="menuitem" press=setSort("newest") popovertarget="sort-menu" popovertargetaction="hide" testId="sort-newest"
          text "Newest"
        button role="menuitem" press=setSort("oldest") popovertarget="sort-menu" popovertargetaction="hide" testId="sort-oldest"
          text "Oldest"
        button role="menuitem" press=setSort("title") popovertarget="sort-menu" popovertargetaction="hide" testId="sort-title"
          text "Title"
      column id="list-ctx-menu" popover="auto" role="menu" aria-label="List options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="list-ctx-menu"
        button press=ctxListOpen popovertarget="list-ctx-menu" popovertargetaction="hide" testId="ctx-list-open"
          text "Open List"
        button press=ctxListNewTask popovertarget="list-ctx-menu" popovertargetaction="hide" testId="ctx-list-newtask"
          text "New Task"
        hr
        button press=ctxListShare popovertarget="list-ctx-menu" popovertargetaction="hide" testId="ctx-list-share"
          text "Share…"
        button press=ctxListEdit popovertarget="list-ctx-menu" popovertargetaction="hide" testId="ctx-list-edit"
          text "Edit…"
        hr
        button press=ctxListAsk popovertarget="list-ctx-menu" popovertargetaction="hide" testId="ctx-list-delete"
          text "Delete…" color="-exact-system-red"
      column id="cal-ctx-menu" popover="auto" role="menu" aria-label="Calendar options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="cal-ctx-menu"
        button press=ctxCalToggle popovertarget="cal-ctx-menu" popovertargetaction="hide" testId="ctx-cal-toggle"
          text (ctxCalRow.isActive ? "Hide" : "Show")
        button press=ctxCalEdit popovertarget="cal-ctx-menu" popovertargetaction="hide" testId="ctx-cal-edit"
          text "Edit…"
      column id="event-menu" popover="auto" role="menu" aria-label="Event options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="event-menu"
        button press=ctxEventOpen popovertarget="event-menu" popovertargetaction="hide" testId="ctx-event-open"
          text "Open Event"
        hr
        button press=ctxEventDelete popovertarget="event-menu" popovertargetaction="hide" testId="ctx-event-delete"
          text "Delete" color="-exact-system-red"
      column id="section-menu" popover="auto" role="menu" aria-label="Section options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="section-menu"
        button press=openSectionStyle(ctxSection) popovertarget="section-style-pop" testId="ctx-section-style"
          text "Name, Icon and Color…"
        if wide or listView != "board"
          button press=ctxSectionFold popovertarget="section-menu" popovertargetaction="hide" testId="ctx-section-fold"
            text (listView == "board" ? (folded(shutCols, ctxSection) ? "Expand" : "Collapse") : (folded(foldedCols, ctxSection) ? "Expand" : "Collapse"))
        button press=ctxSectionAdd popovertarget="section-menu" popovertargetaction="hide" testId="ctx-section-add"
          text "Add Task"
      column id="new-note-menu" popover="auto" role="menu" aria-label="New" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" max-width="20rem" max-height="24rem" overflow-y="auto" testId="new-note-menu"
        button role="menuitem" press=openNewNote popovertarget="new-note-menu" popovertargetaction="hide" testId="add-note"
          text "New Note" font="-exact-headline"
        if tplShown.length > 0
          text "From a template" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for t in tplShown key=t.id
          button role="menuitem" press=openNoteFromTemplate(t.title, t.body) popovertarget="new-note-menu" popovertargetaction="hide" testId=`tpl-${t.id}` display="flex" flex-direction="column" align-items="flex-start" text-align="start"
            text t.name font="-exact-headline" line-clamp=1
            text t.blurb font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
      column id="tpl-menu" popover="auto" role="menu" aria-label="Templates" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" max-width="20rem" max-height="24rem" overflow-y="auto" testId="tpl-menu"
        if tplAll.length > 6
          input type="search" value=tplQuery input=setTplQuery placeholder="Search templates" appearance="none" aria-label="Search templates" testId="tpl-search" padding=8 outline="none"
        for t in tplShown key=t.id
          if nav.tab == "tasks"
            button role="menuitem" press=newListFromTemplate(t.name, t.json) popovertarget="tpl-menu" popovertargetaction="hide" testId=`tpl-${t.id}` display="flex" flex-direction="column" align-items="flex-start" text-align="start"
              text t.name font="-exact-headline" line-clamp=1
              text t.blurb font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
          else
            button role="menuitem" press=openNoteFromTemplate(t.title, t.body) popovertarget="tpl-menu" popovertargetaction="hide" testId=`tpl-${t.id}` display="flex" flex-direction="column" align-items="flex-start" text-align="start"
              text t.name font="-exact-headline" line-clamp=1
              text t.blurb font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
        if tplShown.length == 0
          text "No templates match" color="-exact-secondary-label" padding=8
      column id="empty-notes-menu" popover="auto" role="menu" aria-label="Notes" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="empty-notes-menu"
        button press=openNewNote popovertarget="empty-notes-menu" popovertargetaction="hide" testId="ctx-empty-newnote"
          text "New Note"
      column id="empty-tasks-menu" popover="auto" role="menu" aria-label="Tasks" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="empty-tasks-menu"
        button press=openNewTask popovertarget="empty-tasks-menu" popovertargetaction="hide" testId="ctx-empty-newtask"
          text "New Task"
      column id="empty-cal-menu" popover="auto" role="menu" aria-label="Calendar" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="empty-cal-menu"
        button press=openNewEvent popovertarget="empty-cal-menu" popovertargetaction="hide" testId="ctx-empty-newevent"
          text "New Event"
      column id="note-menu" popover="auto" role="menu" aria-label="Note options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="note-menu"
        button press=openNote(ctxNote) popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-open"
          text "Open Note"
        button press=ctxNotePin popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-pin"
          text (ctxNoteRow.isPinned ? "Unpin" : "Pin")
        button press=openShare(ctxNote) popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-share"
          text "Share…"
        button press=ctxNoteVault popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-vault"
          text (ctxNoteRow.tags.includes("vault") ? "Remove from Vault" : "Add to Vault")
        hr
        if lib.folders.length > 0
          column role="group" aria-label="Move to folder"
            button press=toggleGroup("folder") role="menuitem" aria-expanded=folded(openGroups, "folder") aria-label="Move to folder" testId="grp-folder"
              row gap=8 align-items="center" width="100%"
                text "Move to folder" flex=1 min-width=0 text-align="start"
                text (ctxNoteRow.folder == "" ? "None" : ctxNoteRow.folder) color="-exact-secondary-label" font="-exact-footnote" line-clamp=1
                image (folded(openGroups, "folder") ? "symbol:minus" : "symbol:add")
            if folded(openGroups, "folder")
              button press=ctxNoteFolder("") aria-checked=(ctxNoteRow.folder == "") popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-folder-none"
                text "No folder"
              for f in lib.folders.slice(0, 8) key=f
                button press=ctxNoteFolder(f) aria-checked=(ctxNoteRow.folder == f) popovertarget="note-menu" popovertargetaction="hide" testId=`ctx-note-folder-${f}`
                  text `Move to ${f}`
        hr
        button press=ctxNoteTrash popovertarget="note-menu" popovertargetaction="hide" testId="ctx-note-trash"
          text "Move to Trash" color="-exact-system-red"
      column id="persona-menu" popover="auto" role="menu" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="persona-menu"
        row gap=10 align-items="center" padding="6px 8px"
          Avatar(size=40, name=shown, icon=avatarIcon, color=avatarColor, photoUrl=avatarUrl, fetched=fetchedIcons, testId="persona-avatar", show=true)
          column flex=1 min-width=0 gap=0
            text shown font="-exact-headline" line-clamp=1 testId="persona-name"
            text session.email color="-exact-secondary-label" font="-exact-footnote" line-clamp=1 testId="persona-email"
            ServerLine(host=serverCheck.host, state=serverCheck.state)
        button role="menuitem" press=openSettings popovertarget="persona-menu" popovertargetaction="hide" testId="menu-settings"
          text "Settings"
        button role="menuitem" press=exportLibrary popovertarget="persona-menu" popovertargetaction="hide" -exact-menu="file" aria-label="Export All Notes…" testId="menu-export-library"
          text "Export all notes"
        button role="menuitem" press=doSignOut popovertarget="persona-menu" popovertargetaction="hide" testId="sign-out"
          text "Sign Out"
      column id="notif-pop" popover="auto" role="menu" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" max-height="26rem" overflow-y="auto" testId="notif-pop"
        row gap=8 align-items="center" padding="6px 8px"
          text "Notifications" font="-exact-headline" flex=1 min-width=0
          button press=markAllRead testId="notif-read-all"
            text "Mark all read"
        if notifRows.length == 0
          text "Nothing new." color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px" testId="notif-empty"
        for n in notifRows key=n.id
          button role="menuitem" press=openNotification(n.listId, n.resourceId) popovertarget="notif-pop" popovertargetaction="hide" testId=`notif-${n.id}` appearance="none" width="100%" box-sizing="border-box" padding="6px 8px" border-radius=8 display="flex" align-items="flex-start" gap=8 text-align="start"
            view width=8 height=8 border-radius=4 flex-shrink=0 margin-top=6 background-color=(n.isRead ? "transparent" : "AccentColor")
            column flex=1 min-width=0 gap=2
              text n.title font="-exact-headline" line-clamp=1
              text n.message font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
      dialog id="move-to-trash" role="alertdialog" aria-label="Move to Trash?"
        text "The note moves to the trash. You can restore it there."
        button press=trashIt(selectedNote) destructive=true commandfor="move-to-trash" command="close" testId="trash-confirm"
          text "Move to Trash"
        button commandfor="move-to-trash" command="close" testId="trash-cancel"
          text "Cancel"
      dialog id="delete-forever" role="alertdialog" aria-label="Delete Forever?"
        text "This can’t be undone."
        button press=removeForever destructive=true commandfor="delete-forever" command="close" testId="forever-confirm"
          text "Delete"
        button commandfor="delete-forever" command="close" testId="forever-cancel"
          text "Cancel"
      dialog id="lightbox" closedby="any" aria-label="Image" background-color="#000000eb" width="100%" height="100%" padding=0 display="flex" flex-direction="column" testId="lightbox"
        view position="relative" flex=1 min-height=0 width="100%"
          image lightboxUrl width="100%" height="100%" object-fit="contain" aria-label="Image" testId="lightbox-image"
          if lightboxList.length > 1
            button press=lightboxStep(-1) aria-label="Previous image" testId="lightbox-prev" position="absolute" left=16 top="50%" margin-top=-22 width=44 height=44 border-radius=22 background-color="#00000080" display="flex" align-items="center" justify-content="center"
              LucideIcon(paths=["m15 18-6-6 6-6"], color="#ffffff", size=28)
            button press=lightboxStep(1) aria-label="Next image" testId="lightbox-next" position="absolute" right=16 top="50%" margin-top=-22 width=44 height=44 border-radius=22 background-color="#00000080" display="flex" align-items="center" justify-content="center"
              LucideIcon(paths=["m9 18 6-6-6-6"], color="#ffffff", size=28)
        if lightboxList.length > 1
          scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0 width="100%" box-sizing="border-box" padding="10px 16px calc(env(safe-area-inset-bottom) + 10px)" background-color="#000000" testId="lightbox-strip"
            row gap=8 align-items="center" justify-content="center" min-width="100%" width="max-content"
              for u in lightboxList key=u
                button appearance="none" press=lightboxGo(u) aria-label="Show this image" testId="lightbox-thumb" padding=0 flex-shrink=0 opacity=(u == lightboxUrl ? 1 : 0.5) border=(u == lightboxUrl ? "2px solid #ffffff" : "2px solid transparent") border-radius=6
                  image u width=64 height=48 object-fit="cover" border-radius=4
        button commandfor="lightbox" command="close" aria-label="Close image" testId="lightbox-close" position="absolute" top=16 right=16 width=40 height=40 border-radius=20 background-color="#00000080" color="#ffffff" display="flex" align-items="center" justify-content="center"
          image "symbol:close"
      dialog id="search-sheet" aria-label="Search" padding=16 testId="search-sheet"
        column gap=10 min-width="18rem"
          row gap=8 align-items="center"
            input type="search" value=searchQ input=runSearch placeholder="Search notes, tasks, events" aria-label="Search everything" testId="search-sheet-input" flex=1 min-width=0 appearance="none" outline="none" autofocus=true
            button press=clearSearch commandfor="search-sheet" command="close" testId="search-sheet-close" aria-label="Close search"
              image "symbol:close"
          if searchQ.trim() != ""
            column max-height="60vh" overflow-y="auto" testId="search-sheet-results"
              SearchResults(q=searchQ, found=found, busy=pending(found), openNote=openFoundNote, openTask=openFoundTask, openEvent=openFoundEvent, openFolder=openFoundFolder, openList=openFoundList)
      dialog id="new-folder" aria-label="New folder" padding=20 testId="new-folder"
        column gap=12 min-width="18rem"
          text "New folder" font="-exact-headline"
          input value=newFolderName input=editNewFolderName placeholder="Folder name" aria-label="Folder name" testId="new-folder-name" appearance="none" outline="none"
          row gap=8 align-items="center"
            text "Inside"
            select value=newFolderParent change=pickNewFolderParent aria-label="Parent folder" testId="new-folder-parent" flex=1 min-width=0
              option "None (top level)" value="-"
              for f in lib.folders key=f
                option f value=f
          row gap=8 justify-content="flex-end"
            button commandfor="new-folder" command="close" testId="new-folder-cancel"
              text "Cancel"
            button press=createFolder commandfor="new-folder" command="close" buttonStyle="filled" disabled=(newFolderName.trim() == "") testId="new-folder-create"
              text "Create"
      dialog id="export-options" aria-label="Export notes" padding=20 testId="export-options"
        column gap=12 min-width="18rem"
          text (exportKind == "folder" ? `Export “${lastSegment(folderFilter)}”` : "Export all notes") font="-exact-headline"
          text "Notes are saved as Markdown files in folders, in a zip." color="-exact-secondary-label" font="-exact-footnote"
          row gap=8 align-items="center"
            input type="checkbox" checked=exportVaults change=setExportVaults aria-label="Include vault notes" testId="export-vaults" outline="none"
            text "Include vault notes (named vault-…)"
          row gap=8 justify-content="flex-end"
            button commandfor="export-options" command="close" testId="export-cancel"
              text "Cancel"
            button press=confirmExport commandfor="export-options" command="close" buttonStyle="filled" testId="export-confirm"
              text "Export"
      dialog id="delete-task" role="alertdialog" aria-label="Delete Task?"
        text "The task and its subtasks move away. This can’t be undone."
        button press=removeTaskNow destructive=true commandfor="delete-task" command="close" testId="delete-task-confirm"
          text "Delete"
        button commandfor="delete-task" command="close" testId="delete-task-cancel"
          text "Cancel"
      dialog id="delete-task-ctx" role="alertdialog" aria-label="Delete Task?"
        text "The task and its subtasks move away. This can’t be undone."
        button press=ctxDeleteNow destructive=true commandfor="delete-task-ctx" command="close" testId="ctx-delete-confirm"
          text "Delete"
        button commandfor="delete-task-ctx" command="close" testId="ctx-delete-cancel"
          text "Cancel"
      dialog id="delete-template" role="alertdialog" aria-label="Delete Template?"
        text "The template is removed. Notes and lists made from it stay."
        button press=deleteTemplateNow destructive=true commandfor="delete-template" command="close" testId="delete-template-confirm"
          text "Delete"
        button commandfor="delete-template" command="close" testId="delete-template-cancel"
          text "Cancel"
      dialog id="delete-subtask" role="alertdialog" aria-label="Delete Subtask?"
        text "The subtask is removed. This can’t be undone."
        button press=deleteSubtaskNow destructive=true commandfor="delete-subtask" command="close" testId="subtask-delete-confirm"
          text "Delete"
        button commandfor="delete-subtask" command="close" testId="subtask-delete-cancel"
          text "Cancel"
      dialog id="ai-unavailable" role="alertdialog" aria-label="Apple Intelligence Unavailable"
        text aiMessage testId="ai-unavailable-message"
        button commandfor="ai-unavailable" command="close" testId="ai-unavailable-ok"
          text "OK"
      dialog id="delete-list" role="alertdialog" aria-label="Delete List?"
        text "The list and its tasks are removed. This can’t be undone."
        button press=removeListNow destructive=true commandfor="delete-list" command="close" testId="delete-list-confirm"
          text "Delete List"
        button commandfor="delete-list" command="close" testId="delete-list-cancel"
          text "Cancel"
      dialog id="delete-list-ctx" role="alertdialog" aria-label="Delete List?"
        text "The list and its tasks are removed. This can’t be undone."
        button press=ctxListDelete destructive=true commandfor="delete-list-ctx" command="close" testId="ctx-list-delete-confirm"
          text "Delete List"
        button commandfor="delete-list-ctx" command="close" testId="ctx-list-delete-cancel"
          text "Cancel"
      dialog id="delete-calendar" role="alertdialog" aria-label="Delete Calendar?"
        text "The calendar and its events are removed. This can’t be undone."
        button press=removeCalNow destructive=true commandfor="delete-calendar" command="close" testId="delete-calendar-confirm"
          text "Delete Calendar"
        button commandfor="delete-calendar" command="close" testId="delete-calendar-cancel"
          text "Cancel"
      dialog id="delete-event" role="alertdialog" aria-label="Delete Event?"
        text "This removes the event from the calendar."
        button press=removeEventNow destructive=true commandfor="delete-event" command="close" testId="delete-event-confirm"
          text "Delete"
        button commandfor="delete-event" command="close" testId="delete-event-cancel"
          text "Cancel"

component EditListSheet
  props
    route: number
    list: TaskList
    folders: TaskFolder[]
    fetched: IconPaths[]
    hits: string[]
    query: string
    queryEdit: action
    probe: action
    save: action
    remove: action
    share: action
    cancel: action
    error: string
    saving: bool
    creating: bool
  state name = list.name
  state folderSel = list.folderId == "" ? "-" : list.folderId
  state icon = list.icon
  state color = list.color
  state grocery = list.grocery
  action editName(v: string)
    name = v
  action setGrocery(on: bool)
    grocery = on
  action pickFolderSel(v: string)
    folderSel = v
  action pickIcon(v: string)
    icon = v
    probe(v)
  action pickColor(v: string)
    color = v
  action clearStyle
    icon = ""
    color = ""
  view
    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
      button id="back" press=cancel aria-label="Cancel" testId="edit-list-cancel"
        image "symbol:close"
      text (creating ? "New List" : "Edit List") role="heading"
      button press=save(list.id, name, folderSel, icon, color, grocery) disabled=(name.trim() == "" or saving) buttonStyle="bordered-prominent"
        aria-label="Save" testId="edit-list-save"
        image "symbol:checkmark"
    list id="edit-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="100%"
      section
        row
          input value=name input=editName placeholder="Name" aria-label="Name" testId="edit-list-name" flex=1 min-width=0 appearance="none" outline="none"
        row gap=8 align-items="center"
          text "Folder"
          select value=folderSel change=pickFolderSel aria-label="Folder" testId="edit-list-folder" flex=1 min-width=0
            option "None" value="-"
            for f in folders key=f.id
              option f.name value=f.id
      section
        row gap=8 align-items="center"
          column flex=1 min-width=0 gap=2
            text "Grocery list"
            text "Checked items disappear. Show them again from the list menu." font="-exact-footnote" color="-exact-secondary-label"
          input type="checkbox" checked=grocery change=setGrocery aria-label="Grocery list" testId="edit-list-grocery" outline="none"
      section
        IconColorPicker(icon=icon, color=color, paths=iconPathsOf(icon, fetched), query=query, hits=hits, queryEdit=queryEdit, onIcon=pickIcon, onColor=pickColor, onNone=clearStyle)
      if error != "" and not saving
        section
          row
            text error color="-exact-system-red" testId="edit-list-error"
      if not creating
        section
          row
            button press=share(list.id) testId="edit-list-share" flex=1
              text "Share"
        section
          row
            button press=remove destructive=true testId="edit-list-delete" flex=1
              text "Delete List"

// New section (a modal from the list menu): the name, with the same icon and color choices as a list.
component NewSectionSheet
  props
    route: number
    fetched: IconPaths[]
    hits: string[]
    query: string
    queryEdit: action
    probe: action
    save: action
    cancel: action
    error: string
    saving: bool
  state name = ""
  state icon = ""
  state color = ""
  action editName(v: string)
    name = v
  action pickIcon(v: string)
    icon = v
    probe(v)
  action pickColor(v: string)
    color = v
  action clearStyle
    icon = ""
    color = ""
  view
    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
      button id="back" press=cancel aria-label="Cancel" testId="new-section-cancel"
        image "symbol:close"
      text "New Section" role="heading"
      button press=save(name, icon, color) disabled=(name.trim() == "" or saving) buttonStyle="bordered-prominent"
        aria-label="Add section" testId="add-section"
        image "symbol:checkmark"
    list id="new-section" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="100%"
      section
        row
          input value=name input=editName submit=save(name, icon, color) placeholder="Section name" aria-label="Section name" autofocus=true testId="section-draft" flex=1 min-width=0 appearance="none" outline="none"
      section
        IconColorPicker(icon=icon, color=color, paths=iconPathsOf(icon, fetched), query=query, hits=hits, queryEdit=queryEdit, onIcon=pickIcon, onColor=pickColor, onNone=clearStyle)
      if error != "" and not saving
        section
          row
            text error color="-exact-system-red" testId="section-error"

// The person's avatar, a circle of `size` px. Priority: the photo; else the icon (white, on the color, or the accent);
// else the initial of the name on the accent (or the color). `show` false hides it (the mobile headers hide it when wide).
component Avatar
  props
    size: number
    name: string
    icon: string
    color: string
    photoUrl: string
    fetched: IconPaths[]
    testId: string
    show: bool
  view
    view width=size height=size border-radius="50%" overflow="hidden" flex-shrink=0 display=(show ? "flex" : "none") align-items="center" justify-content="center" background-color=(color == "" ? "AccentColor" : color) testId=testId
      if photoUrl != ""
        image photoUrl width=size height=size object-fit="cover" aria-label=name
      else if icon != ""
        LucideIcon(paths=iconPathsOf(icon, fetched), color="#ffffff", size=size * 0.5)
      else
        text (name.trim() == "" ? "?" : name.trim().slice(0, 1).toUpperCase()) color=(color == "" ? "AccentColorText" : "#ffffff") font="-exact-headline"

// Settings (a modal, from the user menu): the avatar (icon and color, photo, initials), the display name,
// the appearance (Auto follows the system; Light and Dark pin it), and the password. Each change saves at once.
component Settings
  props
    route: number
    shown: string
    email: string
    avatarUrl: string
    avatarIcon: string
    avatarColor: string
    fetched: IconPaths[]
    hits: string[]
    query: string
    queryEdit: action
    probe: action
    appearance: string
    pickAppearance: action
    saveName: action
    saveStyle: action
    pickPhoto: action
    removePhoto: action
    changePasswordNow: action
    nameError: string
    nameSaving: bool
    photoError: string
    photoSaving: bool
    pwError: string
    pwDone: bool
    pwSaving: bool
    done: action
  state picking = false
  state nameDraft = shown
  state icon = avatarIcon
  state color = avatarColor
  state pwCurrent = ""
  state pwNew = ""
  state pwConfirm = ""
  action editName(v: string)
    nameDraft = v
  action editCurrent(v: string)
    pwCurrent = v
  action editNew(v: string)
    pwNew = v
  action editConfirm(v: string)
    pwConfirm = v
  action togglePicking
    picking = not picking
  action pickIcon(v: string)
    icon = v
    probe(v)
    saveStyle(v, color)
  action pickColor(v: string)
    color = v
    saveStyle(icon, v)
  action clearStyle
    icon = ""
    color = ""
    saveStyle("", "")
  action chooseFile
    showPicker("settings-avatar")
  action photoPicked(files: Picked[])
    match files.at(0)
      case some(f)
        pickPhoto(f.name, f.path, f.type)
      case none
        picking = picking
  action savePassword
    if pwCurrent != "" and pwNew.length >= 8 and pwNew == pwConfirm and not pwSaving
      changePasswordNow(pwCurrent, pwNew)
  view
    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
      text "Settings" role="heading"
      button press=done buttonStyle="bordered-prominent" aria-label="Done" testId="settings-done"
        text "Done"
    list id="settings" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="100%"
      section
        row gap=14 align-items="center"
          Avatar(size=56, name=shown, icon=avatarIcon, color=avatarColor, photoUrl=avatarUrl, fetched=fetched, testId="settings-avatar-preview", show=true)
          column flex=1 min-width=0 gap=0
            text shown font="-exact-headline" line-clamp=1
            text email color="-exact-secondary-label" font="-exact-footnote" line-clamp=1
        button press=togglePicking testId="avatar-style"
          text "Choose icon & color"
        if picking
          IconColorPicker(icon=icon, color=color, paths=iconPathsOf(icon, fetched), query=query, hits=hits, queryEdit=queryEdit, onIcon=pickIcon, onColor=pickColor, onNone=clearStyle)
        button press=chooseFile testId="avatar-upload"
          text "Upload photo"
        button press=removePhoto disabled=(avatarUrl == "" or photoSaving) destructive=true testId="avatar-remove"
          text "Remove photo"
        button press=clearStyle testId="avatar-initials"
          text "Use initials"
        if photoError != "" and not photoSaving
          text photoError color="-exact-system-red" font="-exact-footnote" testId="avatar-error"
        input type="file" accept="image/*" id="settings-avatar" display="none" change=photoPicked testId="settings-avatar-input" outline="none"
      section
        row gap=8 align-items="center"
          input value=nameDraft input=editName placeholder="Display name" aria-label="Display name" enterkeyhint="done" testId="settings-name" flex=1 min-width=0 appearance="none" outline="none"
        if nameError != "" and not nameSaving
          text nameError color="-exact-system-red" font="-exact-footnote" testId="settings-name-error"
        button press=saveName(nameDraft.trim()) disabled=(nameDraft.trim() == "" or nameSaving) testId="settings-name-save"
          text "Save Name"
      section
        text "Appearance" color="-exact-secondary-label" font="-exact-footnote"
        row role="radiogroup" aria-label="Appearance" gap=0
          for m in ["auto", "light", "dark"] key=m
            button role="radio" aria-checked=(appearance == m) press=pickAppearance(m) testId=`appearance-${m}` flex=1 height=32 border-radius=8 display="flex" align-items="center" justify-content="center" background-color=(appearance == m ? "light-dark(#e5e5ea, #3a3a3c)" : "transparent")
              text (m == "auto" ? "Auto" : m == "light" ? "Light" : "Dark")
      section
        input type="password" value=pwCurrent input=editCurrent placeholder="Current password" aria-label="Current password" testId="pw-current" appearance="none" outline="none"
        input type="password" value=pwNew input=editNew placeholder="New password (8+ characters)" aria-label="New password" testId="pw-new" appearance="none" outline="none"
        input type="password" value=pwConfirm input=editConfirm placeholder="Confirm new password" aria-label="Confirm new password" testId="pw-confirm" appearance="none" outline="none"
        if pwError != "" and not pwSaving
          text pwError color="-exact-system-red" font="-exact-footnote" testId="pw-error"
        if pwDone and not pwSaving
          text "Password changed" color="-exact-secondary-label" font="-exact-footnote" testId="pw-done"
        button press=savePassword disabled=(pwCurrent == "" or pwNew.length < 8 or pwNew != pwConfirm or pwSaving) testId="pw-save"
          text "Change Password"

// A lucide icon: its paths (24x24, stroke 2, round caps and joins). An empty color draws in the current text color.
component LucideIcon
  props
    paths: string[]
    color: string
    size: number
  view
    svg viewBox="0 0 24 24" width=size height=size fill="none" stroke=(color == "" ? "currentColor" : color) stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      for p in paths key=p
        path d=p

// Icon and color for a list or a section: 20 icons (bundled, shown at once) plus a lucide name
// search (hits are chips; a name not in the bundle is fetched by the App), 15 colors, and None.
// Scrolls inside its container.
component IconColorPicker
  props
    icon: string
    color: string
    paths: string[]
    query: string
    hits: string[]
    queryEdit: action
    onIcon: action
    onColor: action
    onNone: action
  view
    column gap=10 padding=8 box-sizing="border-box" max-height=360 overflow-y="auto" testId="icon-color-picker"
      row gap=10 align-items="center"
        LucideIcon(paths=paths, color=color, size=28)
        text (icon == "" ? "No icon" : icon) color="-exact-secondary-label" flex=1 min-width=0
        button press=onNone aria-label="No icon or color" testId="pick-none"
          text "None"
      input value=query input=queryEdit placeholder="Lucide icon name" aria-label="Lucide icon name" testId="icon-name-input" appearance="none" outline="none"
      if hits.length > 0
        row gap=6 flex-wrap="wrap"
          for n in hits key=n
            button press=onIcon(n) aria-label=n testId=`icon-hit-${n}` padding="4px 8px" border-radius=8 background-color="light-dark(#e5e5ea, #3a3a3c)"
              text n font="-exact-footnote"
      row gap=4 flex-wrap="wrap"
        for name in bundledNames() key=name
          button press=onIcon(name) aria-label=name testId=`pick-icon-${name}` width=40 height=40 border-radius=8 display="flex" align-items="center" justify-content="center" background-color=(icon == name ? "light-dark(#e5e5ea, #3a3a3c)" : "transparent")
            LucideIcon(paths=iconPaths(name), color=color, size=22)
      ColorSwatches(color=color, onColor=onColor, prefix="pick-color-")

// A kanban card's content (title, assignee/due marks, its subtasks with checkboxes, the open button); the board row around it
// is either the whole drag handle (wide windows: hold to lift) or has a grip beside it (narrow ones: the card scrolls freely).
component BoardCardBody
  props
    tk: Task
    todayMs: number
    today: string
    offset: number
    members: Member[]
    subs: Task[]
    toggle: action
    open: action
  view
    view testId=`board-title-${tk.id}` flex=1 min-width=0 display="flex" flex-direction="column" gap=6
      button appearance="none" press=open(tk.id) aria-label=`Open ${tk.title}` testId=`task-open-${tk.id}` width="100%" display="flex" text-align="start" padding=0 min-height=32
        TaskLabel(tk=tk, todayMs=todayMs, today=today, offset=offset, members=members)
      if tk.subtaskCount > 0
        for st in subs key=st.id
          row gap=6 align-items="center" padding-left=18
            input type="checkbox" checked=st.isDone change=toggle(st.id) aria-label=`Check off ${st.title}` testId=`board-subtask-${st.id}` flex-shrink=0 outline="none"
            text st.title color="-exact-secondary-label" font="-exact-footnote" flex=1 min-width=0 line-clamp=1

// A person on a task: their initial on their colour (the list's members carry it), small.
component Assignee
  props
    name: string
    color: string
    size: number
  view
    view width=size height=size border-radius="50%" flex-shrink=0 display="flex" align-items="center" justify-content="center" background-color=(color == "" ? "AccentColor" : color) aria-label=`Assigned to ${name}` testId="assignee-mark"
      text (name.trim() == "" ? "?" : name.trim().slice(0, 1).toUpperCase()) color=(color == "" ? "AccentColorText" : "#ffffff") font-size=size * 0.6 font-weight=600

// A row of templates (the built-ins, then the person's own, which have a delete): a card starts a new note or list from one.
component TemplateRow
  props
    label: string
    kind: string
    items: TemplateItem[]
    use: action
    useList: action
    remove: action
  view
    column gap=10 testId=`templates-${kind}`
      text label font="-exact-headline" role="heading" aria-level=2
      row flex-wrap="wrap" gap=12
        for t in items key=t.id
          row gap=4 align-items="flex-start" flex="1 1 13rem" max-width="20rem" min-width=0 box-sizing="border-box" padding-right=(t.builtin ? 0 : 6) border-radius=12 background-color="light-dark(#f2f2f7, #2c2c2e)"
            if kind == "note"
              button press=use(t.title, t.body) appearance="none" aria-label=`New note from ${t.name}` testId=`template-${t.id}` flex=1 min-width=0 box-sizing="border-box" padding=14 display="flex" flex-direction="column" gap=4 text-align="start"
                text t.name font="-exact-headline" line-clamp=1
                text t.blurb font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
            else
              button press=useList(t.name, t.json) appearance="none" aria-label=`New list from ${t.name}` testId=`template-${t.id}` flex=1 min-width=0 box-sizing="border-box" padding=14 display="flex" flex-direction="column" gap=4 text-align="start"
                text t.name font="-exact-headline" line-clamp=1
                text t.blurb font="-exact-footnote" color="-exact-secondary-label" line-clamp=2
            if not t.builtin
              button press=remove(t.id) appearance="none" aria-label=`Delete template ${t.name}` testId=`template-delete-${t.id}` margin-top=8 width=24 height=24 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:close" width=12 height=12

component TaskLabel
  props
    tk: Task
    todayMs: number
    today: string
    offset: number
    members: Member[]
  view
    column gap=2 flex=1 min-width=0
      row gap=4 align-items="baseline"
        if tk.assigneeId != ""
          Assignee(name=memberOf(members, tk.assigneeId).name, color=memberOf(members, tk.assigneeId).color, size=18)
        text tk.title font-weight=600 flex=1 min-width=0 line-clamp=1
        if bangs(tk.priority) != ""
          text bangs(tk.priority) color="-exact-system-orange" font="-exact-headline" flex-shrink=0
        if tk.flagged
          text "⚑" color="-exact-system-orange" flex-shrink=0
      if tk.latestBody != ""
        row gap=4 align-items="center" testId=`task-latest-${tk.id}`
          Avatar(size=16, name=memberOf(members, tk.latestBy).name, icon="", color=memberOf(members, tk.latestBy).color, photoUrl=memberOf(members, tk.latestBy).photo, fetched=[], testId=`task-latest-avatar-${tk.id}`, show=true)
          text firstLine(tk.latestBody) color="-exact-secondary-label" font="-exact-footnote" line-clamp=1 flex=1 min-width=0
      if tk.dueAt != 0 or tk.recurrence != "none" or tk.subtaskCount > 0 or tk.tags.length > 0
        row gap=6 align-items="center" flex-wrap="wrap"
          if tk.dueAt != 0
            text dueText(tk, todayMs, offset)
              color=(isOverdue(tk, today, todayMs) ? "-exact-system-red" : "-exact-secondary-label")
              font="-exact-footnote"
          if tk.recurrence != "none"
            image "symbol:repeat" color="-exact-secondary-label"
          if tk.subtaskCount > 0
            text `${tk.subtaskCount} subtask${tk.subtaskCount == 1 ? "" : "s"}` color="-exact-secondary-label" font="-exact-footnote"
          for t in tk.tags key=t
            text `#${t}` color="-exact-secondary-label" font="-exact-footnote"

component TaskEditor
  props
    route: number
    task: Task
    creating: bool
    listId: string
    lists: TaskList[]
    sections: Section[]
    subs: Task[]
    members: Member[]
    assign: action
    saveClose: action
    wide: bool
    drawer: bool
    zoom: action
    images: Attachment[]
    save: action
    trash: action
    cancel: action
    addSubtask: action
    toggleSubtask: action
    renameSubtask: action
    removeSubtask: action
    addImage: action
    error: string
    saving: bool
    offset: number
    today: string
    noteRows: TaskNote[]
    me: string
    todayMs: number
    fetched: IconPaths[]
    postNote: action
    dropNote: action
  // The toolbar's collapsed-code hook is the note editor's; here it is never called.
  action noCode
    touched = touched
  action noExtra(v: string)
    touched = touched
  // A field follows the task (changed on the board, by someone else, or by a menu) until the person edits it here: the drawer
  // never saves a stale copy over what the board changed.
  state touched = ""
  state titleV = task.title
  derive title = folded(touched, "title") ? titleV : task.title
  state notesV = task.notes
  derive notes = folded(touched, "notes") ? notesV : task.notes
  state urlV = task.url
  derive url = folded(touched, "url") ? urlV : task.url
  state dueDateV = task.dueDay
  derive dueDate = folded(touched, "dueDate") ? dueDateV : task.dueDay
  state timeTextV = task.dueTime
  derive timeText = folded(touched, "timeText") ? timeTextV : task.dueTime
  state reminderSelV = reminderOf(task)
  derive reminderSel = folded(touched, "reminderSel") ? reminderSelV : reminderOf(task)
  state repeatSelV = task.recurrence
  derive repeatSel = folded(touched, "repeatSel") ? repeatSelV : task.recurrence
  state flaggedV = task.flagged
  derive flagged = folded(touched, "flagged") ? flaggedV : task.flagged
  state prioritySelV = `${task.priority}`
  derive prioritySel = folded(touched, "prioritySel") ? prioritySelV : `${task.priority}`
  state tagsTextV = task.tags.join(", ")
  derive tagsText = folded(touched, "tagsText") ? tagsTextV : task.tags.join(", ")
  state listSel = listId
  // The section follows the task (a card dragged on the board while this is open) until the person picks one here.
  state sectionPicked = false
  state sectionChosen = ""
  derive sectionSel = sectionPicked ? sectionChosen : task.sectionId
  state noteDraft = ""
  action editNoteDraft(v: string)
    noteDraft = v
  // Taps on the row around the field (inside a list a field only takes focus from its own tap): focus it.
  action focusNoteDraft
    focus("task-note-draft")
  action submitNote
    postNote(task.id, noteDraft)
    noteDraft = ""
  state subtaskDraft = ""
  state editingSub = ""
  state subEditDraft = ""
  derive parsedTags = tagsText.split(",").map(t => t.trim()).filter(t => t != "")
  derive parsedPriority = match parseNumber(prioritySel) { case some(n) => n, case none => 0 }
  derive hasDate = dueDate != ""
  derive hasTime = timeText != ""
  derive sameList = listSel == listId
  derive openSubtasks = subs.filter(s => not s.isDone)
  derive doneSubtasks = subs.filter(s => s.isDone)
  action editTitle(v: string)
    titleV = v
    touched = touch(touched, "title")
  action editNotes(v: string)
    notesV = v
    touched = touch(touched, "notes")
  action editUrl(v: string)
    urlV = v
    touched = touch(touched, "url")
  action toggleDate(on: bool)
    dueDateV = on ? today : ""
    timeTextV = ""
    touched = touch(touch(touched, "dueDate"), "timeText")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, (on ? today : ""), "", reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action editDue(v: string)
    dueDateV = v
    touched = touch(touched, "dueDate")
  action toggleTime(on: bool)
    timeTextV = on ? "09:00" : ""
    touched = touch(touched, "timeText")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, (on ? "09:00" : ""), reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action editTime(v: string)
    timeTextV = v
    touched = touch(touched, "timeText")
  action pickRepeat(v: string)
    repeatSelV = v
    touched = touch(touched, "repeatSel")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, v, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action pickReminder(v: string)
    reminderSelV = v
    touched = touch(touched, "reminderSel")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, v, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action toggleFlag(on: bool)
    flaggedV = on
    touched = touch(touched, "flagged")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, on, parsedPriority, parsedTags, listSel, sectionSel)
  action pickPriority(v: string)
    prioritySelV = v
    touched = touch(touched, "prioritySel")
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, match parseNumber(v) { case some(n) => n, case none => 0 }, parsedTags, listSel, sectionSel)
  action editTags(v: string)
    tagsTextV = v
    touched = touch(touched, "tagsText")
  action pickList(v: string)
    listSel = v
    sectionPicked = true
    sectionChosen = ""
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, parsedPriority, parsedTags, v, "")
  action pickSection(v: string)
    sectionPicked = true
    sectionChosen = v
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, v)
  action editSubtaskDraft(v: string)
    subtaskDraft = v
  action submitSubtask
    addSubtask(listId, task.id, subtaskDraft)
    subtaskDraft = ""
  action startSubEdit(s: Task)
    editingSub = s.id
    subEditDraft = s.title
  action editSubDraft(v: string)
    subEditDraft = v
  // Enter or blur commits; a blank or unchanged title just drops out of editing.
  action commitSubEdit(s: Task)
    if editingSub == s.id and subEditDraft.trim() != "" and subEditDraft.trim() != s.title
      renameSubtask(s.id, subEditDraft.trim(), s.notes, s.url, s.dueDay, s.dueTime, reminderOf(s), s.recurrence, s.flagged, s.priority, s.tags, s.sectionId)
    editingSub = ""
    subEditDraft = ""
  state fmtFormats = ""
  state fmtUnavailable = ""
  state fmtLink = ""
  action selectedFmt(s)
    fmtFormats = s.formats
    fmtUnavailable = s.unavailable
    fmtLink = s.link
  // Native format bar (as in NoteEditor): the hatch sends "platform:ios" and "cmd:<name>:<n>" through the hidden bridge.
  state nativeBar = false
  state bridgeValue = ""
  action bridgeInput(v: string)
    bridgeValue = v
    if v == "platform:ios"
      nativeBar = true
    else if v.startsWith("link:")
      format("task-notes", "link", v.split(":").slice(2).join(":"))
    else if v.startsWith("cmd:")
      match v.slice(4).split(":").at(0)
        case some(c)
          nativeCmd(c)
        case none
          bridgeValue = ""
  // Taps on the empty part of the notes row: focus the field with the caret at its end.
  action focusNotes
    focus("task-notes")
    setSelectionRange("task-notes", notes.length, notes.length)
  action nativeCmd(name: string)
    if name == "heading"
      format("task-notes", "heading", "2")
    else if name == "dismiss"
      blur("task-notes")
    else
      format("task-notes", name)
  // An existing task saves a field when it is left (and a switch or menu when it changes); a new task waits for Add.
  action autoSave
    if not creating and title.trim() != ""
      save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action doSave
    saveClose(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
  action pickImage
    showPicker("task-image")
  action imagePicked(files: Picked[])
    match files.at(0)
      case some(f)
        save(task.id, title, notes, url, dueDate, timeText, reminderSel, repeatSel, flagged, parsedPriority, parsedTags, listSel, sectionSel)
        addImage(task.id, f.name, f.path, f.type)
      case none
        touched = touched
  derive simple = listOf(lists, listSel).grocery
  // The drawer lays the form out in two columns (two lists side by side); the sheet keeps one.
  derive cols = drawer ? ["left", "right"] : ["all"]
  view
    header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
      if creating
        button id="back" press=cancel aria-label="Cancel" testId="new-task-cancel"
          image "symbol:close"
      text (simple ? (creating ? "New Item" : "Item") : creating ? "New Reminder" : "Task") role="heading" aria-level=2 flex="1 1 6rem"
      if creating
        button press=doSave disabled=(title.trim() == "" or saving) buttonStyle="bordered-prominent"
          aria-label="Add" testId="new-task-add"
          image "symbol:checkmark"
      else
        // An existing task saves each field as it is left; the check only puts the editor away.
        button id="back" press=cancel buttonStyle="bordered-prominent" aria-label="Done" testId="task-done"
          image "symbol:checkmark"
    row flex=1 min-height=0 width="100%" gap=8
      for col in cols key=col
        list id=(col == "all" ? "task-edit" : `task-edit-${col}`) appearance="auto" listStyle="inset-grouped" flex=1 min-width=0 min-height=0
          if col != "right"
            section
              row
                input value=title input=editTitle placeholder="Title" aria-label="Title" blur=autoSave testId="task-title" flex=1 min-width=0 appearance="none" outline="none"
                input hatch="formatbar" data-role="bridge" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink value=bridgeValue input=bridgeInput aria-hidden=true testId="task-notes-bridge" position="absolute" width="0.1rem" height="0.1rem" opacity=0 pointer-events="none" outline="none"
              if creating
                row press=focusNotes width="100%" min-width=0 max-width="100%"
                  textarea id="task-notes" value=notes input=editNotes blur=autoSave placeholder="Notes" aria-label="Notes"
                    hatch="formatbar" data-role="editor" data-images="0" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink
                    markup="markdown" rows=6 testId="task-notes" flex=1 min-width=0 width="100%" max-width="100%" white-space="pre-wrap" overflow-wrap="anywhere" outline="none" field-sizing="content" overflow-y="hidden" min-height=(drawer ? "5rem" : "8rem") padding="8px 0" select=selectedFmt
                row display=(nativeBar ? "none" : "flex") padding-top=8 padding-bottom=8
                  MarkdownToolbar(editor="task-notes", prefix="tfmt", formats=fmtFormats, unavailable=fmtUnavailable, link=fmtLink, imageInput="", collapsed=false, codeHere=noCode, extras=false, extra=noExtra, imageLine=false, imageHref="", imageLink=noExtra)
          if col != "right"
            if not creating
              section
                header
                  text "Notes" testId="task-notes-header"
                for n in noteRows key=n.id
                  row gap=10 align-items="flex-start" testId=`task-note-${n.id}`
                    Avatar(size=28, name=n.name, icon=n.icon, color=n.color, photoUrl=n.photo, fetched=fetched, testId=`task-note-avatar-${n.id}`, show=true)
                    column flex=1 min-width=0 gap=2
                      row gap=6 align-items="baseline"
                        text (n.name == "" ? "You" : n.name) font="-exact-subheadline" line-clamp=1 testId=`task-note-author-${n.id}`
                        text (n.createdAt == 0 ? "Now" : formatDay(n.createdAt, todayMs, offset, "list")) color="-exact-secondary-label" font="-exact-footnote" flex-shrink=0 testId=`task-note-time-${n.id}`
                      text n.body white-space="pre-wrap" overflow-wrap="anywhere" testId=`task-note-body-${n.id}`
                    if n.name == "" or n.email == me
                      button press=dropNote(task.id, n.id) appearance="none" aria-label="Delete note" testId=`task-note-delete-${n.id}`
                        image "symbol:delete"
                row press=focusNoteDraft gap=8 align-items="flex-end" width="100%" min-width=0
                  textarea id="task-note-draft" value=noteDraft input=editNoteDraft placeholder="Add a note" aria-label="New note" rows=2 testId="task-note-draft" flex=1 min-width=0 white-space="pre-wrap" overflow-wrap="anywhere" outline="none" field-sizing="content" overflow-y="hidden" min-height="2.5rem" padding="8px 0"
                  button press=submitNote disabled=(noteDraft.trim() == "") testId="task-note-add"
                    text "Add"
          if col != "right"
            if not simple
              section
                row
                  input type="url" value=url input=editUrl placeholder="URL" aria-label="URL" blur=autoSave testId="task-url" flex=1 min-width=0 appearance="none" outline="none"
          if col != "right"
            if not simple
              section
                row gap=8 align-items="center"
                  text "Date" flex=1 min-width=0
                  input type="checkbox" switch checked=hasDate change=toggleDate aria-label="Date" testId="task-date-toggle" outline="none"
                if hasDate
                  row
                    input type="date" value=dueDate input=editDue aria-label="Due date" blur=autoSave testId="task-due" flex=1 min-width=0 outline="none"
                if hasDate
                  row gap=8 align-items="center"
                    text "Time" flex=1 min-width=0
                    input type="checkbox" switch checked=hasTime change=toggleTime aria-label="Time" testId="task-time-toggle" outline="none"
                if hasTime
                  row
                    input type="time" value=timeText input=editTime aria-label="Time of day" blur=autoSave testId="task-time" flex=1 min-width=0 outline="none"
                if hasDate
                  row gap=8 align-items="center"
                    text "Repeat" flex=1 min-width=0
                    select value=repeatSel change=pickRepeat aria-label="Repeat" testId="task-repeat" flex=1 min-width=0
                      option "Never" value="none"
                      option "Every Day" value="daily"
                      option "Every Weekday" value="weekdays"
                      option "Every Week" value="weekly"
                      option "Every Month" value="monthly"
                      option "Every Year" value="yearly"
                if hasDate
                  row gap=8 align-items="center"
                    text "Reminder" flex=1 min-width=0
                    select value=reminderSel change=pickReminder aria-label="Reminder" testId="task-reminder" flex=1 min-width=0
                      option "None" value="none"
                      option "At time of due" value="due"
                      option "1 hour before" value="1h"
                      option "1 day before" value="1d"
                      option "Custom" value="keep"
          if col != "right"
            if not simple
              section
                row gap=8 align-items="center"
                  text "Flag" flex=1 min-width=0
                  input type="checkbox" switch checked=flagged change=toggleFlag aria-label="Flag" testId="task-flag" outline="none"
                row gap=8 align-items="center"
                  text "Priority" flex=1 min-width=0
                  select value=prioritySel change=pickPriority aria-label="Priority" testId="task-priority" flex=1 min-width=0
                    option "None" value="0"
                    option "Low" value="1"
                    option "Medium" value="2"
                    option "High" value="3"
                row
                  text "Tags"
                  input value=tagsText input=editTags placeholder="Comma, separated" aria-label="Tags" blur=autoSave testId="task-tags" flex=1 min-width=0 appearance="none" outline="none"
          if col != "right"
            section
              if not creating and members.length > 1
                row gap=8 align-items="center"
                  text "Assigned to" flex=1 min-width=0
                  select value=task.assigneeId change=assign(task.id) aria-label="Assigned to" testId="task-assignee" flex=1 min-width=0
                    option "Nobody" value=""
                    for m in members key=m.id
                      option m.name value=m.id
              row gap=8 align-items="center"
                text "List" flex=1 min-width=0
                select value=listSel change=pickList aria-label="List" testId="task-list" flex=1 min-width=0
                  for l in lists key=l.id
                    option l.name value=l.id
              if sameList
                row gap=8 align-items="center"
                  text "Section" flex=1 min-width=0
                  select value=sectionSel change=pickSection aria-label="Section" testId="task-section" flex=1 min-width=0
                    option "Uncategorized" value=""
                    for s in sections key=s.id
                      option s.name value=s.id
          if col != "left"
            if not simple
              if not creating
                section
                  header
                    text "Subtasks" testId="subtasks-header"
                  row gap=8 align-items="center"
                    column flex=1 min-width=0 gap=4
                      input value=subtaskDraft input=editSubtaskDraft submit=submitSubtask placeholder="Add a subtask" appearance="none" outline="none"
                        aria-label="New subtask" testId="subtask-draft"
                    button press=submitSubtask disabled=(subtaskDraft.trim() == "") testId="add-subtask"
                      text "Add"
                  for s in openSubtasks key=s.id
                    row gap=8 align-items="center"
                      input type="checkbox" checked=s.isDone change=toggleSubtask(s.id) aria-label=`Check off ${s.title}` testId=`subtask-${s.id}` outline="none"
                      if editingSub == s.id
                        input value=subEditDraft input=editSubDraft submit=commitSubEdit(s) blur=commitSubEdit(s) autofocus=true aria-label=`Rename ${s.title}` testId=`subtask-edit-${s.id}` flex=1 min-width=0 appearance="none" outline="none"
                      else
                        view press=startSubEdit(s) flex=1 min-width=0 testId=`subtask-title-${s.id}`
                          text s.title
                      if members.length > 1
                        select value=s.assigneeId change=assign(s.id) aria-label=`Assign ${s.title}` testId=`subtask-assignee-${s.id}` flex-shrink=0 max-width="7rem"
                          option "Nobody" value=""
                          for m in members key=m.id
                            option m.name value=m.id
                      button press=removeSubtask(s.id) aria-label=`Delete ${s.title}` testId=`subtask-delete-${s.id}`
                        image "symbol:delete"
                  if doneSubtasks.length > 0
                    row
                      text "Done" color="-exact-secondary-label" font="-exact-footnote"
                    for s in doneSubtasks key=s.id
                      row gap=8 align-items="center"
                        input type="checkbox" checked=s.isDone change=toggleSubtask(s.id) aria-label=`Check off ${s.title}` testId=`subtask-${s.id}` outline="none"
                        if editingSub == s.id
                          input value=subEditDraft input=editSubDraft submit=commitSubEdit(s) blur=commitSubEdit(s) autofocus=true aria-label=`Rename ${s.title}` testId=`subtask-edit-${s.id}` flex=1 min-width=0 appearance="none" outline="none"
                        else
                          view press=startSubEdit(s) flex=1 min-width=0 testId=`subtask-title-${s.id}`
                            text s.title color="-exact-secondary-label"
                        button press=removeSubtask(s.id) aria-label=`Delete ${s.title}` testId=`subtask-delete-${s.id}`
                          image "symbol:delete"
          if col != "left"
            if not creating
              section
                header
                  text "Images" testId="task-images-header"
                row gap=8 align-items="center"
                  button press=pickImage testId="task-image"
                    text "Add Image"
                if images.length > 0
                  row flex-wrap="wrap" gap=8
                    for a in images key=a.id
                      button appearance="none" press=zoom(a.url, images.map(x => x.url).join("\n")) aria-label="View image full size" testId=`task-image-view-${a.id}` padding=0
                        image a.url width=104 height=104
          if col != "left"
            if error != "" and not saving
              section
                row
                  text error color="-exact-system-red" testId="task-save-error"
          if col != "left"
            if not creating
              section
                row
                  button press=trash destructive=true testId="task-delete" flex=1
                    text "Delete Task"
    input type="file" accept="image/*" id="task-image" display="none" change=imagePicked testId="task-image-input" outline="none"

component SignIn
  props
    error: string
    pendingAuth: bool
    signIn: action
    register: action
    server: string
    fallback: string
    saved: string[]
    registration: bool
    demoEmail: string
    demoPassword: string
    saveServer: action
    serverError: string
    eyePaths: string[]
    eyeOffPaths: string[]
  state serverOpen = false
  state reveal = false
  state serverDraft = ""
  state email = ""
  state password = ""
  state name = ""
  state mode = "signin"
  action editEmail(v: string)
    email = v
  action toggleReveal
    reveal = not reveal
  action toggleServer
    serverOpen = not serverOpen
  action editServer(v: string)
    serverDraft = v
  // Picking a saved server, or typing a new one, saves it for the app and tucks the panel away.
  // An address that cannot be one stays open so its error shows.
  action pickServer(v: string)
    if v != server
      saveServer(v)
    serverOpen = false
  action useTyped
    let v = serverDraft.trim()
    if v == ""
      serverOpen = false
    else if v.startsWith("http://") or v.startsWith("https://")
      saveServer(v)
      serverOpen = false
      serverDraft = ""
    else
      saveServer(v)
  action editPassword(v: string)
    password = v
  action editName(v: string)
    name = v
  action setMode(v: string)
    mode = v
  action submit
    if email.trim() != "" and password != "" and not pendingAuth
      if mode == "signin"
        signIn(email.trim(), password)
      else
        register(name.trim(), email.trim(), password)
  view
    column flex=1 min-height=0 display="flex" flex-direction="column"
      scroll flex=1 min-height=0
        column width="min(23rem, calc(100% - 2rem))" margin="0 auto" padding="48px 16px 16px" gap=12
          image "assets/notient.svg" width=64 height=64 margin="0 auto 8px" aria-label="Notient" testId="auth-logo"
          text (mode == "signin" ? "Sign in to Notient" : "Create your account") role="heading" aria-level=1 font-size="min(-exact-title1, 31px)" text-align="center"
          if mode == "register"
            input value=name input=editName placeholder="Name" aria-label="Name" enterkeyhint="next" testId="name" border="1px solid light-dark(#c6c6c8, #48484a)" border-radius=10 padding="10px 12px" appearance="none" outline="none"
          input type="email" value=email input=editEmail placeholder="Email" aria-label="Email" border="1px solid light-dark(#c6c6c8, #48484a)" border-radius=10 padding="10px 12px" appearance="none" outline="none"
            autocapitalize="none" enterkeyhint="next" autofocus=true testId="email"
          view position="relative" display="flex" align-items="center"
            input type=(reveal ? "text" : "password") value=password input=editPassword submit=submit placeholder="Password" outline="none"
              aria-label="Password" testId="password" flex=1 min-width=0 width="100%" border="1px solid light-dark(#c6c6c8, #48484a)" border-radius=10 padding="10px 40px 10px 12px" appearance="none"
            button press=toggleReveal aria-label=(reveal ? "Hide password" : "Show password") testId="password-reveal" position="absolute" right=8 top="50%" margin-top=-14 display="flex" appearance="none" padding=4
              LucideIcon(paths=(reveal ? eyeOffPaths : eyePaths), color="", size=20)
          if error != "" and not pendingAuth
            text error color="-exact-system-red" testId="auth-error"
          button press=submit disabled=(email.trim() == "" or password == "" or pendingAuth) buttonStyle="filled" testId="submit-auth"
            text (mode == "signin" ? "Sign In" : "Create Account")
          if registration or mode == "register"
            button press=setMode(mode == "signin" ? "register" : "signin") testId="toggle-auth"
              text (mode == "signin" ? "Need an account? Register" : "Have an account? Sign In")
          if demoEmail != ""
            column gap=2 padding="8px 0" testId="demo-note"
              text "Demo server" font="-exact-footnote" color="-exact-label" text-align="center"
              text `Sign in as ${demoEmail} with the password ${demoPassword}.` font="-exact-footnote" color="-exact-secondary-label" text-align="center"
              text "The demo account is wiped and reset every 5 minutes, so don't keep anything here." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
      column width="min(23rem, calc(100% - 2rem))" margin="0 auto" gap=8 padding="0 16px 8px"
        button press=toggleServer testId="server-toggle"
          text (server == "" ? "Use your own server" : `Server: ${server}`) font="-exact-footnote" color="-exact-secondary-label"
        if serverOpen
          column gap=4 testId="server-choices"
            button press=pickServer("") appearance="none" testId="server-choice-default" display="flex" align-items="center" gap=6 padding="6px 4px"
              if server == ""
                image "symbol:checkmark" width=14 height=14
              text `Default (${fallback})` font="-exact-footnote" color="-exact-label"
            for s in saved key=s
              button press=pickServer(s) appearance="none" testId=`server-choice-${s}` display="flex" align-items="center" gap=6 padding="6px 4px"
                if server == s
                  image "symbol:checkmark" width=14 height=14
                text s font="-exact-footnote" color="-exact-label"
          input type="url" value=serverDraft input=editServer submit=useTyped placeholder="Add a server: https://notes.example.com" aria-label="Server address" autocapitalize="none" autocorrect="off" testId="server-input" border="1px solid light-dark(#c6c6c8, #48484a)" border-radius=10 padding="10px 12px" appearance="none" outline="none"
          if serverError != ""
            text serverError color="-exact-system-red" testId="server-error"
          button press=useTyped buttonStyle="bordered" testId="server-save"
            text "Use This Server"
          text "Changing the server signs you out." font="-exact-footnote" color="-exact-secondary-label"
      row gap=16 justify-content="center" flex-wrap="wrap" padding="12px 16px calc(env(safe-area-inset-bottom) + 12px)" testId="auth-footer"
        link href=path("privacy") testId="privacy-link"
          text "Privacy Policy" font="-exact-footnote" color="-exact-secondary-label"
        link href=path("terms") testId="terms-link"
          text "Terms of Service" font="-exact-footnote" color="-exact-secondary-label"

component LegalPage
  props
    route: number
    title: string
  view
    column navigationKey=`${route}` position="absolute" inset=0 display="flex" flex-direction="column"
      header padding="8px 16px"
        text title role="heading" aria-level=1
      scroll flex=1 min-height=0
        column width="min(36rem, calc(100% - 2rem))" margin="0 auto" padding=16 gap=12
          text "This document has not been published yet." color="-exact-secondary-label" testId="legal-body"

component NoteBlocks
  props
    body: string
    editable: bool
    toggle: action
    copy: action
    copiedKey: string
    hl: CodeBlock[]
    blocksId: string
    vault: bool
    eyePaths: string[]
    eyeOffPaths: string[]
    zoom: action
  // A vault note draws its code hidden; the eye shows or hides each one (keys `<block>` or `<block>-<span>`).
  state shownKeys = ""
  action peek(key: string)
    shownKeys = folded(shownKeys, key) ? shownKeys.split(" ").filter(x => x != key and x != "").join(" ") : (shownKeys + " " + key).trim()
  derive lines = body.split("\n")
  derive blocks = blocksOf(lines, blockStarts(lines))
  derive allImages = lines.filter(l => isImageLine(l) and imgHref(l) == "").map(l => imgSrc(l)).join("\n")
  action toggleBlock(i: number, checked: bool)
    if editable
      toggle(i)
  view
    column testId=blocksId width="100%" max-width="100%" box-sizing="border-box" gap=8 padding="8px 0px"
      for b in blocks key=`${b.index}`
        if b.kind == "task"
          row gap=8 align-items="flex-start" padding-left=`${16 + b.indent * 10}px` padding-right="16px"
            input type="checkbox" checked=b.checked disabled=(not editable) change=toggleBlock(b.index) aria-label=`Check off ${b.text}` testId=`view-task-${b.index}` outline="none"
            text b.text markup="markdown" flex=1 min-width=0 user-select="text" overflow-wrap="anywhere" width="100%" max-width="100%" box-sizing="border-box" font-size=17 line-height="26px"
        else if b.kind == "image"
          column width="100%" padding="4px 16px" box-sizing="border-box" testId=`view-image-${b.index}`
            if imgHref(b.text) != ""
              link href=imgHref(b.text) aria-label=`Open ${imgHref(b.text)}` testId=`view-image-link-${b.index}`
                image imgSrc(b.text) width="100%" max-width="15rem" max-height="15rem" object-fit="contain" aria-label=imgAlt(b.text)
            else
              button appearance="none" press=zoom(imgSrc(b.text), allImages) aria-label="View image full size" testId=`view-image-zoom-${b.index}` padding=0 width="100%"
                image imgSrc(b.text) width="100%" max-width="15rem" max-height="15rem" object-fit="contain" aria-label=imgAlt(b.text)
        else if b.kind == "gallery"
          column width="100%" box-sizing="border-box" padding="4px 16px" testId=`view-gallery-${b.index}`
            row gap=8 flex-wrap="wrap" align-items="flex-start"
              for g in b.text.split("\n") key=g
                if imgHref(g) != ""
                  link href=imgHref(g) aria-label=`Open ${imgHref(g)}` flex-shrink=0
                    image imgSrc(g) width="15rem" max-width="100%" height=160 border-radius=8 object-fit="cover" aria-label=imgAlt(g)
                else
                  button appearance="none" press=zoom(imgSrc(g), allImages) aria-label="View image full size" padding=0 flex-shrink=0 testId=`view-gallery-zoom-${b.index}`
                    image imgSrc(g) width="15rem" max-width="100%" height=160 border-radius=8 object-fit="cover" aria-label=imgAlt(g)
        else if b.kind == "link"
          text user-select="text" overflow-wrap="anywhere" width="100%" max-width="100%" box-sizing="border-box" font-size=linkSize(b.text) font-weight=(headLevel(b.text) > 0 ? 700 : 400) line-height=(headLevel(b.text) > 0 ? "34px" : "26px") padding=`0px 16px 0px ${16 + (quoteLine(b.text) ? 12 : 0) + b.text.indexOf(b.text.trim().slice(0, 1)) * 5}px`
            for sp in spansOf(lineBody(b.text)) key=sp.k
              if sp.href != ""
                text unescapeMd(sp.text) href=sp.href color="-exact-system-blue" font-weight=700 font-size=linkSize(b.text)
              else
                text unescapeMd(sp.text) font-size=linkSize(b.text) font-weight=(headLevel(b.text) > 0 ? 700 : 400)
        else if b.kind == "inline"
          row flex-wrap="wrap" align-items="baseline" gap=4 width="100%" box-sizing="border-box" padding="0px 16px"
            for sp in inlineSpans(b.text) key=sp.k
              if sp.href == "code"
                row gap=2 align-items="center"
                  button appearance="none" press=copy(sp.text, `${blocksId}-${b.index}-${sp.k}`) aria-label="Copy code" testId=`view-code-copy-${b.index}-${sp.k}` padding="2px 8px" border-radius=8 min-width=0
                    background-color=(copiedKey == `${blocksId}-${b.index}-${sp.k}` ? "light-dark(#d9f2e0, #1f4a2e)" : "light-dark(#f2f2f7, #2c2c2e)")
                    transition="background-color -exact-spring(300, 30, 1)"
                    text (vault and not folded(shownKeys, `${b.index}-${sp.k}`) ? vaultMask() : sp.text) font-family="monospace" font-size=15 overflow-wrap="anywhere" color=(copiedKey == `${blocksId}-${b.index}-${sp.k}` ? "-exact-system-green" : "-exact-label")
                  if vault
                    button appearance="none" press=peek(`${b.index}-${sp.k}`) aria-label=(folded(shownKeys, `${b.index}-${sp.k}`) ? "Hide" : "Reveal") testId=`view-code-eye-${b.index}-${sp.k}` min-width=28 min-height=28 display="flex" align-items="center" justify-content="center" flex-shrink=0
                      LucideIcon(paths=(folded(shownKeys, `${b.index}-${sp.k}`) ? eyeOffPaths : eyePaths), color="", size=18)
              else
                text sp.text font-size=17 line-height="26px" overflow-wrap="anywhere" min-width=0
        else if b.kind == "code"
          column width="100%" padding="0px 16px" box-sizing="border-box"
            view position="relative" width="100%" box-sizing="border-box" border-radius=10 overflow="hidden"
              background-color=(copiedKey == `${blocksId}-${b.index}` ? "light-dark(#d9f2e0, #1f4a2e)" : "light-dark(#f2f2f7, #2c2c2e)")
              transition="background-color -exact-spring(300, 30, 1)" testId=`view-code-box-${b.index}`
              text font-family="monospace" font-size=14 line-height="20px" white-space="pre-wrap" overflow-wrap="anywhere" width="100%" max-width="100%" box-sizing="border-box" padding="12px 14px" pointer-events="none"
                if vault and not folded(shownKeys, `${b.index}`)
                  text vaultMask()
                else
                  if codeTokens(hl, b.text).length == 0
                    text b.text
                  for tk in codeTokens(hl, b.text) key=`${tk.i}`
                    text tk.t color=tokenColor(tk.k) font-weight=(tk.k == "kw" ? 600 : 400)
              image "symbol:checkmark" position="absolute" top=8 right=10 width=18 height=18 color="-exact-system-green" aria-hidden=true pointer-events="none"
                opacity=(copiedKey == `${blocksId}-${b.index}` ? 1 : 0) scale=(copiedKey == `${blocksId}-${b.index}` ? 1 : 0.4)
                transition="opacity -exact-spring(300, 30, 1), scale -exact-spring(300, 30, 1)"
              button appearance="none" press=copy(b.text, `${blocksId}-${b.index}`) aria-label="Copy code" testId=`view-code-copy-${b.index}` position="absolute" inset=0 width="100%" height="100%"
              if vault
                button appearance="none" press=peek(`${b.index}`) aria-label=(folded(shownKeys, `${b.index}`) ? "Hide" : "Reveal") testId=`view-code-eye-${b.index}` position="absolute" top=4 right=34 width=32 height=32 display="flex" align-items="center" justify-content="center"
                  LucideIcon(paths=(folded(shownKeys, `${b.index}`) ? eyeOffPaths : eyePaths), color="", size=18)
        else
          text b.text markup="markdown" user-select="text" overflow-wrap="anywhere" width="100%" max-width="100%" box-sizing="border-box" font-size=17 line-height="26px" padding="0px 16px"

component NoteEditor
  props
    wide: bool
    route: number
    noteId: string
    title: string
    body: string
    folder: string
    tagsText: string
    folderPool: string[]
    tagPool: string[]
    pinned: bool
    mode: string
    metaLine: string
    saving: bool
    error: string
    imageError: string
    editTitle: action
    editBody: action
    editFolder: action
    editTags: action
    togglePin: action
    toggleLine: action
    startEdit: action
    saveAndClose: action
    trash: action
    share: action
    saveTpl: action
    exportIt: action
    pickImageDone: action
    chromeHidden: bool
    onScroll: action
    fresh: bool
    onCaret: action
    onImage: action
    imageSelected: bool
    imageHref: string
    copy: action
    copiedKey: string
    hl: CodeBlock[]
    zoom: action
    vault: bool
    toggleVault: action
    eyePaths: string[]
    eyeOffPaths: string[]
  state titleEditing = fresh
  // The selection in the body, tracked so the code button can act on a bare caret.
  state selStart = 0
  state selEnd = 0
  derive selCollapsed = selStart == selEnd
  // Divider at the caret (no Markdown command for it: a rule line).
  action extraFmt(kind: string)
    if kind == "rule"
      let at = min(selEnd, body.length)
      let before = at == 0 ? "" : (body.slice(at - 1, at) == "\n" ? "\n" : "\n\n")
      setRangeText("note-body", before + "___\n\n", at, at)
  action linkImage(url: string)
    onImage(`link:${url.trim()}`)
  action selMoved(e: InputEvent)
    selStart = e.selectionStart
    selEnd = e.selectionEnd
    onCaret(e)
  // Code on a bare caret: `code` between ticks, the word selected so typing or pasting replaces it.
  action codePlaceholder
    setRangeText("note-body", "`code`", selStart, selStart)
    setSelectionRange("note-body", selStart + 1, selStart + 5)
  state fmtFormats = ""
  state fmtUnavailable = ""
  state fmtLink = ""
  // A tap on the empty part of a read-only note edits it, with the keyboard up.
  state wantFocus = false
  action tapToEdit
    wantFocus = true
    startEdit()
  // Native format bar (iOS hatch "formatbar"; rich-text.md "Native format bar"): Swift sends "platform:ios"
  // and "cmd:<name>:<n>" through the hidden bridge input; n makes each tap a new value.
  state nativeBar = false
  state bridgeValue = ""
  action selectedFmt(s)
    fmtFormats = s.formats
    fmtUnavailable = s.unavailable
    fmtLink = s.link
  action bridgeInput(v: string)
    bridgeValue = v
    if v == "platform:ios"
      nativeBar = true
    else if v.startsWith("link:")
      format("note-body", "link", v.split(":").slice(2).join(":"))
    else if v.startsWith("cmd:")
      match v.slice(4).split(":").at(0)
        case some(c)
          nativeCmd(c)
        case none
          bridgeValue = ""
  action nativeCmd(name: string)
    if name == "heading"
      format("note-body", "heading", "2")
    else if name == "image"
      showPicker("note-image")
    else if name == "dismiss"
      blur("note-body")
    else
      format("note-body", name)
  action startTitleEdit
    titleEditing = true
  action doneTitleEdit
    titleEditing = false
    focus("note-body")
  action imagePicked(files: Picked[])
    if files.length > 0
      pickImageDone(files.map(f => f.name).join("\n"), files.map(f => f.path).join("\n"), files.map(f => f.type).join("\n"))
  // The filler below the text: focus the body with the caret at its end (focus alone leaves the caret where it was).
  action focusBody
    focus("note-body")
    setSelectionRange("note-body", body.length, body.length)
  // Popover suggestions: the pools arrive recent-first / popular-first; what is typed filters them.
  derive folderMatches = folderPool.filter(f => f != "" and f != folder and (folder.trim() == "" or f.toLowerCase().includes(folder.trim().toLowerCase()))).slice(0, 5)
  derive tagLast = match tagsText.split(",").at(-1) { case some(t) => t.trim(), case none => "" }
  derive tagOthers = tagsText.split(",").slice(0, tagsText.split(",").length - 1).map(t => t.trim()).filter(t => t != "")
  derive tagMatches = tagPool.filter(t => not tagOthers.includes(t) and (tagLast == "" or t.toLowerCase().startsWith(tagLast.toLowerCase()))).slice(0, 6)
  action pickFolder(name: string)
    editFolder(name)
    hidePopover("note-folder-pop")
  // The tag replaces the last token and the text ends with ", " so the person can keep adding.
  action pickTag(tag: string)
    editTags((tagOthers.length > 0 ? tagOthers.join(", ") + ", " : "") + tag + ", ")
  view
    column navigationKey=`${route}` position="absolute" inset=0 box-sizing="border-box" padding-top=(wide ? 44 : 0)
      display="flex" flex-direction="column"
      header display=(chromeHidden ? "none" : "flex") align-items="center" gap=8 padding=(wide ? "8px 12px 0" : "8px 16px") position=(wide ? "absolute" : "relative") top=0 right=0 z-index=(wide ? 11 : 0) box-sizing="border-box" border-bottom="none"
        if not wide
          text (mode == "edit" ? "Edit Note" : "View Note") role="heading" aria-level=2 flex=1 font-size="min(-exact-title3, 31px)"
        button press=toggleVault aria-label=(vault ? "Turn off vault" : "Make a vault note") testId="note-vault" color=(vault ? "AccentColor" : "-exact-label")
          image "symbol:lock"
        button press=togglePin aria-label=(pinned ? "Unpin note" : "Pin note") testId="note-pin"
          image "symbol:pin"
        if wide
          button press=exportIt aria-label="Export Note…" -exact-menu="file" testId="note-export" disabled=(noteId == "")
            LucideIcon(paths=["M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4", "m7 10 5 5 5-5", "M12 15V3"], color="-exact-label", size=18)
          button press=saveTpl aria-label="Save as template" testId="note-template" disabled=(title.trim() == "" and body.trim() == "")
            LucideIcon(paths=["M4 3h16a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z", "M4 14h7a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z", "M17 14h2a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z"], color="-exact-label", size=18)
        else
          button press=exportIt aria-label="Export Note…" -exact-menu="file" testId="note-export" disabled=(noteId == "")
            image "symbol:download"
          button press=saveTpl aria-label="Save as template" testId="note-template" disabled=(title.trim() == "" and body.trim() == "")
            image "symbol:sf/doc.badge.plus"
        button press=share(noteId) aria-label="Share" testId="note-share"
          image "symbol:share"
        button press=trash aria-label="Move to Trash" testId="note-trash"
          image "symbol:delete"
        if mode == "edit"
          button press=saveAndClose disabled=((title.trim() == "" and (noteId != "" or body.trim() == "")) or saving) aria-label="Save and close" testId="note-save"
            image "symbol:checkmark"
        else
          button press=startEdit aria-label="Edit" testId="note-edit"
            image "symbol:compose"
      row display=(chromeHidden ? "none" : "flex") gap=8 align-items="center" padding="8px 16px" flex-wrap="wrap"
        if titleEditing
          input value=title input=editTitle placeholder="Title" aria-label="Title" autofocus=true appearance="none" outline="none"
            submit=doneTitleEdit testId="note-title" flex=1 min-width=0
          button press=doneTitleEdit aria-label="Done" testId="note-title-done"
            image "symbol:checkmark"
        else
          button press=startTitleEdit testId="note-title-display" flex=1 min-width=0 text-align="start" buttonStyle="gray"
            text (title == "" ? "Untitled" : title) font-size="min(-exact-title3, 31px)"
        button popovertarget="note-folder-pop" aria-label="Folder" testId="note-folder-button"
          image "symbol:filter"
        button popovertarget="note-tags-pop" aria-label="Tags" testId="note-tags-button"
          image "symbol:hashtag"
      if mode == "edit"
        row display=(nativeBar ? "none" : "flex") gap=8 align-items="center" padding=(chromeHidden ? "19px 16px 4px 16px" : "4px 16px")
          view flex=1 min-width=0
            MarkdownToolbar(editor="note-body", prefix="fmt", formats=fmtFormats, unavailable=fmtUnavailable, link=fmtLink, imageInput="note-image", collapsed=selCollapsed, codeHere=codePlaceholder, extras=true, extra=extraFmt, imageLine=imageSelected, imageHref=imageHref, imageLink=linkImage)
        if imageSelected
          row gap=8 align-items="center" padding="4px 16px" testId="image-bar"
            text "Image" font="-exact-footnote" color="-exact-secondary-label" flex=1
            button appearance="none" press=onImage("up") retainFocus=true aria-label="Move image up" testId="image-up" min-height=40 padding=8
              image "symbol:send"
            button appearance="none" press=onImage("down") retainFocus=true aria-label="Move image down" testId="image-down" min-height=40 padding=8
              image "symbol:download"
            button appearance="none" press=onImage("remove") retainFocus=true aria-label="Remove image" testId="image-remove" min-height=40 padding=8
              image "symbol:delete"
        // Hidden bridge for the iOS format bar hatch (inert on the web).
        input hatch="formatbar" data-role="bridge" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink value=bridgeValue input=bridgeInput aria-hidden=true testId="fmt-bridge" position="absolute" width="0.1rem" height="0.1rem" opacity=0 pointer-events="none" outline="none"
        scroll flex=1 min-height=0 width="100%" overflow-x="hidden" box-sizing="border-box" scroll=onScroll testId="note-edit-scroll"
          // Native: the column is exactly the viewport and the textarea fills it and scrolls itself
          // (a UITextView taps, selects and keeps its caret in view). On the web the page script
          // (server/web/notient-keyboard.js) makes it grow with the content instead, so the page
          // scrolls as one (see rich-text.md "Keyboard").
          column height="100%" box-sizing="border-box" testId="note-edit-column"
            textarea id="note-body" value=body input=editBody select=selectedFmt selectionchange=selMoved scroll=onScroll placeholder="Start writing" aria-label="Body" autofocus=wantFocus
              hatch="formatbar" data-role="editor" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink
              markup="markdown" testId="note-body" flex=1 min-height=0 width="100%" outline="none" box-sizing="border-box" padding="8px 16px 48px 16px"
      else
        scroll flex=1 min-height=0 width="100%" overflow-x="hidden" box-sizing="border-box" scroll=onScroll testId="note-view-scroll"
          column min-height="100%" box-sizing="border-box" display="flex" flex-direction="column"
            NoteBlocks(body=body, editable=true, toggle=toggleLine, copy=copy, copiedKey=copiedKey, hl=hl, blocksId="note-body-view", vault=vault, eyePaths=eyePaths, eyeOffPaths=eyeOffPaths, zoom=zoom)
            button appearance="none" press=tapToEdit aria-label="Edit note" testId="note-view-tap" flex=1 min-height=160 width="100%"
            view height=48 flex-shrink=0
      // Info footer: pinned under the page scroller in both modes.
      column gap=2 padding="6px 16px" position="absolute" left=0 right=0 bottom=0 background-color="light-dark(#ffffffd9, #000000d9)" backdrop-filter="blur(12px)" border-top="0.5px solid -exact-separator" pointer-events="none" testId="note-footer"
        if error != "" and not saving
          text error color="-exact-system-red" font="-exact-footnote" testId="note-save-error"
        if imageError != ""
          text imageError color="-exact-system-red" font="-exact-footnote" testId="note-image-error"
        text metaLine color="-exact-secondary-label" font="-exact-footnote" testId="note-info"
      input type="file" accept="image/*" multiple=true id="note-image" display="none" change=imagePicked testId="note-image-input" outline="none"
    column id="note-folder-pop" popover="auto" padding=8 gap=4 testId="note-folder-pop"
      row gap=8 align-items="center"
        text "Folder" font="-exact-footnote" color="-exact-secondary-label"
        input value=folder input=editFolder placeholder="None" aria-label="Folder" autofocus=true appearance="none" outline="none"
          testId="note-folder" flex=1 min-width=0
      for f, i in folderMatches key=f
        button appearance="none" press=pickFolder(f) retainFocus=true aria-label=`Use folder ${f}` testId=`folder-suggest-${i}` text-align="start" padding="6px 8px"
          text f
    column id="note-tags-pop" popover="auto" padding=8 gap=4 testId="note-tags-pop"
      row gap=8 align-items="center"
        text "Tags" font="-exact-footnote" color="-exact-secondary-label"
        input value=tagsText input=editTags placeholder="Comma, separated" aria-label="Tags" autofocus=true appearance="none" outline="none"
          testId="note-tags" flex=1 min-width=0
      for t, i in tagMatches key=t
        button appearance="none" press=pickTag(t) retainFocus=true aria-label=`Add tag ${t}` testId=`tag-suggest-${i}` text-align="start" padding="6px 8px"
          text t

// The 15-color row; each swatch's testId is the prefix and the hex without its #.
// One event as a plain row (color bar, title, location, time). The agenda under the month grid and
// the week's day sections both use it.
component AgendaRow
  props
    ev: EventRow
    calendars: CalendarItem[]
    openMenu: action
  view
    link href=path("eventDetail", ev.id) testId=`event-${ev.id}` display="block" contextPopover="event-menu" contextmenu=openMenu(ev.id)
      row gap=10 align-items="stretch" padding="10px 16px"
        view width=3 border-radius=2 flex-shrink=0 background-color=calColor(calendars, ev.calendarId)
        column flex=1 min-width=0 gap=2
          text ev.title line-clamp=1
          if ev.location != ""
            text ev.location font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
        text ev.time color="-exact-secondary-label" font="-exact-footnote" flex-shrink=0 testId=`event-time-${ev.id}`

// The desktop sidebar (`wide`: the window 900 px and over, in place of exact's own): the brand, then the Notes
// and Tasks trees that hold what their phone screens list, the Calendar row with its ten events, and the
// signed-in user at the bottom, which opens the persona menu. Each tree opens at a fixed height (it scrolls
// inside) that "Show more" lifts, and folds shut from its chevron; so do its folders and lists.
component DesktopSidebar
  props
    serverHost: string
    serverState: string
    current: string
    selected: string
    signedIn: bool
    shown: string
    email: string
    unread: number
    notes: Note[]
    noteFolders: string[]
    query: string
    tasks: RecentTask[]
    events: EventRow[]
    lists: TaskList[]
    folders: TaskFolder[]
    notesOpen: bool
    notesTall: bool
    tasksOpen: bool
    tasksTall: bool
    openedRows: string
    openListId: string
    folderDraft: string
    folderError: string
    avatarUrl: string
    avatarIcon: string
    avatarColor: string
    fetched: IconPaths[]
    pick: action
    openListMenu: action
    openNote: action
    openNoteMenu: action
    openEventMenu: action
    openTask: action
    openList: action
    addTask: action
    search: action
    newNote: action
    trash: action
    newList: action
    editFolder: action
    addFolder: action
    toggleNotes: action
    toggleNotesTall: action
    toggleTasks: action
    toggleTasksTall: action
    toggleFold: action
    newFolder: action
  view
    column testId="sidebar" width="23rem" height="100%" flex-shrink=0 box-sizing="border-box" padding=12 gap=6 display="flex" flex-direction="column" background-color="light-dark(#eef1f6, #1a1c21)"
      view testId="sidebar-top" height=32 flex-shrink=0
      scroll flex="1 1 0%" min-height=0 overflow-y="auto"
        column gap=10
          column gap=4
            row gap=2 align-items="center"
              button press=toggleNotes aria-label=(notesOpen ? "Collapse Notes" : "Expand Notes") testId="side-notes-fold" appearance="none" width=28 height=36 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:forward-chevron" width=12 height=12 transform=(notesOpen ? "rotate(90deg)" : "rotate(0deg)")
              button press=pick("notes") testId="side-tab-notes" appearance="none" color=(current == "notes" ? "AccentColor" : "-exact-label") flex=1 min-width=0 height=36 box-sizing="border-box" padding="0 8px" border-radius=8 display="flex" align-items="center" gap=8 background-color=(current == "notes" ? "light-dark(#dde4f0, #2e3441)" : "transparent")
                image "symbol:document" width=22 height=22
                text "Notes" font="-exact-headline"
              button press=newNote aria-label="New Note" testId="side-new-note" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                image "symbol:compose" width=16 height=16
              button popovertarget="sort-menu" aria-label="Sort" testId="side-sort" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                image "symbol:sort" width=16 height=16
              button press=newFolder aria-label="New Folder" testId="side-new-note-folder" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                LucideIcon(paths=["M12 10v6", "M9 13h6", "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"], color="-exact-label", size=16)
              button press=trash aria-label="Trash" testId="side-trash" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                image "symbol:delete" width=16 height=16
            if notesOpen
              column gap=1 padding-left=38 max-height=(notesTall ? "none" : "16rem") overflow=(notesTall ? "visible" : "hidden auto") testId="side-notes-tree"
                if notes.length == 0
                  text (query.trim() == "" ? "No notes yet." : "No matches.") flex-shrink=0 font="-exact-footnote" color="-exact-secondary-label" padding="4px 8px" testId="side-notes-empty"
                for f in noteFolders key=f
                  if (notes.filter(n => inFolder(n, f)).length > 0 or f != "") and noteFolders.filter(a => a != "" and f.startsWith(a + "/") and folded(openedRows, `n:${a}`)).length == 0
                    if noteFolders.length > 1
                      button press=toggleFold(`n:${f}`) aria-label=((not folded(openedRows, `n:${f}`) or query.trim() != "" or notes.filter(x => x.id == selected and inFolder(x, f)).length > 0) ? `Collapse ${folderLabel(f)}` : `Expand ${folderLabel(f)}`) testId=`side-folder-${f}` appearance="none" width="100%" height=28 flex-shrink=0 box-sizing="border-box" padding-left=(8 + folderDepth(f) * 16) padding-right=8 border-radius=6 display="flex" align-items="center" gap=6
                        image "symbol:forward-chevron" width=11 height=11 flex-shrink=0 transform=((not folded(openedRows, `n:${f}`) or query.trim() != "" or notes.filter(x => x.id == selected and inFolder(x, f)).length > 0) ? "rotate(90deg)" : "rotate(0deg)")
                        text (f == "" ? "Unfiled" : lastSegment(f)) font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 line-clamp=1 text-align="start"
                        text `${notes.filter(n => inFolder(n, f)).length}` font="-exact-footnote" color="-exact-secondary-label"
                    if (not folded(openedRows, `n:${f}`) or query.trim() != "" or notes.filter(x => x.id == selected and inFolder(x, f)).length > 0)
                      for n in notes.filter(n => inFolder(n, f)) key=n.id
                        button press=openNote(n.id) appearance="none" testId=`side-note-${n.id}` width="100%" height=28 flex-shrink=0 box-sizing="border-box" padding-left=(noteFolders.length > 1 ? 24 + folderDepth(f) * 16 : 8) padding-right=8 border-radius=6 display="flex" align-items="center" background-color=(selected == n.id ? "light-dark(#dde4f0, #2e3441)" : "transparent") contextPopover="note-menu" contextmenu=openNoteMenu(n.id)
                          text (n.title.trim() == "" ? "Untitled" : n.title) font="-exact-footnote" font-weight=600 line-clamp=1 text-align="start"
              if notes.length + noteFolders.length > 9
                button press=toggleNotesTall testId="side-notes-more" appearance="none" height=24 padding="0 8px 0 46px" display="flex" align-items="center" color="-exact-secondary-label"
                  text (notesTall ? "Show less" : "Show more") font="-exact-footnote"
          column gap=4
            row gap=2 align-items="center"
              button press=toggleTasks aria-label=(tasksOpen ? "Collapse Tasks" : "Expand Tasks") testId="side-tasks-fold" appearance="none" width=28 height=36 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                image "symbol:forward-chevron" width=12 height=12 transform=(tasksOpen ? "rotate(90deg)" : "rotate(0deg)")
              button press=pick("tasks") testId="side-tab-tasks" appearance="none" color=(current == "tasks" ? "AccentColor" : "-exact-label") flex=1 min-width=0 height=36 box-sizing="border-box" padding="0 8px" border-radius=8 display="flex" align-items="center" gap=8 background-color=(current == "tasks" ? "light-dark(#dde4f0, #2e3441)" : "transparent")
                image "symbol:list" width=22 height=22
                text "Tasks" font="-exact-headline"
              button press=newList aria-label="New list" testId="side-new-list" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                image "symbol:add" width=16 height=16
              button popovertarget="side-folder-pop" aria-label="New folder" testId="side-new-folder" appearance="none" width=28 height=28 flex-shrink=0 border-radius=6 display="flex" align-items="center" justify-content="center"
                image "symbol:layers" width=16 height=16
            if tasksOpen
              column gap=1 padding-left=38 max-height=(tasksTall ? "none" : "16rem") overflow=(tasksTall ? "visible" : "hidden auto") testId="side-tasks-tree"
                if lists.length == 0
                  text "No lists yet." font="-exact-footnote" color="-exact-secondary-label" padding="4px 8px" testId="side-tasks-empty"
                for f in withUnfiled(folders) key=f.id
                  if lists.filter(l => l.folderId == f.id).length > 0
                    if f.id != ""
                      button press=toggleFold(`f:${f.id}`) aria-label=((not folded(openedRows, `f:${f.id}`) or lists.filter(x => x.folderId == f.id and x.id == openListId).length > 0) ? `Collapse ${f.name}` : `Expand ${f.name}`) testId=`side-task-folder-${f.id}` appearance="none" width="100%" height=28 flex-shrink=0 box-sizing="border-box" padding="0 8px" border-radius=6 display="flex" align-items="center" gap=6
                        image "symbol:forward-chevron" width=11 height=11 flex-shrink=0 transform=((not folded(openedRows, `f:${f.id}`) or lists.filter(x => x.folderId == f.id and x.id == openListId).length > 0) ? "rotate(90deg)" : "rotate(0deg)")
                        text f.name font="-exact-footnote" font-weight=600 flex=1 min-width=0 line-clamp=1 text-align="start"
                    if (not folded(openedRows, `f:${f.id}`) or lists.filter(x => x.folderId == f.id and x.id == openListId).length > 0)
                      for l in lists.filter(x => x.folderId == f.id) key=l.id
                        row align-items="center" flex-shrink=0 padding-left=(f.id == "" ? 0 : 16)
                          if tasks.filter(t => t.listId == l.id).length > 0
                            button press=toggleFold(`l:${l.id}`) aria-label=(opened(openedRows, `l:${l.id}`, l.id == openListId) ? `Collapse ${l.name}` : `Expand ${l.name}`) testId=`side-list-fold-${l.id}` appearance="none" width=20 height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                              image "symbol:forward-chevron" width=10 height=10 transform=(opened(openedRows, `l:${l.id}`, l.id == openListId) ? "rotate(90deg)" : "rotate(0deg)")
                          else
                            view width=20 flex-shrink=0
                          button press=openList(l.id) testId=`side-list-${l.id}` appearance="none" flex=1 min-width=0 height=28 box-sizing="border-box" padding="0 8px" border-radius=6 display="flex" align-items="center" gap=6 contextPopover="list-ctx-menu" contextmenu=openListMenu(l.id)
                            if l.icon != ""
                              LucideIcon(paths=iconPathsOf(l.icon, fetched), color=l.color, size=16)
                            else
                              view width="0.5rem" height="0.5rem" border-radius=4 flex-shrink=0 background-color=dotOf(l.color)
                            text l.name font="-exact-footnote" font-weight=600 color=colorOr(l.color) line-clamp=1 min-width=0 text-align="start"
                          button press=addTask(l.id) aria-label=`Add task to ${l.name}` testId=`side-list-add-${l.id}` appearance="none" width=24 height=28 flex-shrink=0 display="flex" align-items="center" justify-content="center"
                            image "symbol:add" width=14 height=14
                        if opened(openedRows, `l:${l.id}`, l.id == openListId)
                          for t in tasks.filter(x => x.listId == l.id) key=t.id
                            button press=openTask(t.listId, t.id) appearance="none" testId=`side-task-${t.id}` width="100%" height=26 flex-shrink=0 box-sizing="border-box" padding-left=(f.id == "" ? 36 : 52) padding-right=8 border-radius=6 display="flex" align-items="center"
                              text t.title font="-exact-footnote" color="-exact-secondary-label" line-clamp=1 min-width=0 text-align="start"
              if tasks.length + lists.length + folders.length > 9
                button press=toggleTasksTall testId="side-tasks-more" appearance="none" height=24 padding="0 8px 0 46px" display="flex" align-items="center" color="-exact-secondary-label"
                  text (tasksTall ? "Show less" : "Show more") font="-exact-footnote"
          column gap=2
            button press=pick("calendar") testId="side-tab-calendar" appearance="none" color=(current == "calendar" ? "AccentColor" : "-exact-label") width="100%" height=36 box-sizing="border-box" padding="0 8px" border-radius=8 display="flex" align-items="center" gap=8 background-color=(current == "calendar" ? "light-dark(#dde4f0, #2e3441)" : "transparent")
              image "symbol:calendar" width=22 height=22
              text "Calendar" font="-exact-headline"
            column padding-left=38
              for ev in events key=ev.id
                link href=path("eventDetail", ev.id) testId=`side-event-${ev.id}` text-decoration="none" display="flex" align-items="center" gap=6 height=28 box-sizing="border-box" padding="0 8px" border-radius=6 contextPopover="event-menu" contextmenu=openEventMenu(ev.id)
                  text ev.dayShort font="-exact-footnote" color="-exact-secondary-label" text-decoration="none" flex-shrink=0
                  text ev.title font="-exact-footnote" color="-exact-secondary-label" text-decoration="none" line-clamp=1 min-width=0
      column id="side-folder-pop" popover="auto" padding=8 gap=4 width="17.5rem" testId="side-folder-pop"
        row gap=8 align-items="center"
          column flex=1 min-width=0 gap=4
            input value=folderDraft input=editFolder submit=addFolder placeholder="New folder for lists" aria-label="New folder" autofocus=true testId="side-folder-draft" appearance="none" outline="none"
            if folderError != ""
              text folderError font="-exact-footnote" color="-exact-system-red" testId="side-folder-error"
          button press=addFolder disabled=(folderDraft.trim() == "") testId="side-add-folder"
            text "Add"
      if signedIn
        row margin-top="auto" width="100%" gap=4 align-items="center"
          button popovertarget="persona-menu" aria-label=`Signed in as ${shown}` testId="sidebar-user" appearance="none" flex=1 min-width=0 box-sizing="border-box" padding=8 border-radius=10 display="flex" align-items="center" gap=10 text-align="start"
            Avatar(size=32, name=shown, icon=avatarIcon, color=avatarColor, photoUrl=avatarUrl, fetched=fetched, testId="sidebar-avatar", show=true)
            column flex=1 min-width=0 gap=0
              text shown font="-exact-subheadline" line-clamp=1
              text email font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
              ServerLine(host=serverHost, state=serverState)
          NotifBell(count=unread)

// The notifications bell: one image in the button (a button holding anything else draws its label on Android), the count
// beside it as a badge that does not take taps.
// The server this app talks to, with a check mark when it answered and accepted the token.
component ServerLine
  props
    host: string
    state: string
  view
    row gap=4 align-items="center" testId="server-line" aria-label=`Server ${host}: ${state == "ok" ? "connected" : state == "auth" ? "sign-in refused" : state == "" ? "checking" : "not reachable"}`
      if state == "ok"
        image "symbol:checkmark" color="-exact-system-green" flex-shrink=0 testId="server-ok"
      if state != "ok" and state != ""
        image "symbol:alert" color="-exact-system-red" flex-shrink=0 testId="server-bad"
      text (host == "" ? "Checking…" : host) color=(state == "auth" or state == "down" or state == "error" ? "-exact-system-red" : "-exact-secondary-label") font="-exact-caption2" line-clamp=1 flex=1 min-width=0

component SearchResults
  props
    q: string
    found: Found
    busy: bool
    openNote: action
    openTask: action
    openEvent: action
    openFolder: action
    openList: action
  view
    column gap=2 width="100%" testId="search-results"
      if found.q == q.trim() and found.notes.length + found.tasks.length + found.events.length + found.folders.length + found.lists.length == 0 and not busy
        text "No matches." color="-exact-secondary-label" font="-exact-footnote" padding=8 testId="search-empty"
      if found.folders.length > 0
        text "Folders" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for f in found.folders key=f.id
          button press=openFolder(f.id) appearance="none" width="100%" text-align="start" padding="6px 8px" border-radius=8 testId=`found-folder-${f.id}`
            column gap=1 min-width=0
              text f.title font-weight=600 line-clamp=1
              if f.sub != ""
                text f.sub font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
      if found.lists.length > 0
        text "Lists" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for l in found.lists key=l.id
          button press=openList(l.id) appearance="none" width="100%" text-align="start" padding="6px 8px" border-radius=8 testId=`found-list-${l.id}`
            text l.title font-weight=600 line-clamp=1
      if found.notes.length > 0
        text "Notes" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for n in found.notes key=n.id
          button press=openNote(n.id) appearance="none" width="100%" text-align="start" padding="6px 8px" border-radius=8 testId=`found-note-${n.id}`
            column gap=1 min-width=0
              text (n.title.trim() == "" ? "Untitled" : n.title) font-weight=600 line-clamp=1
              if n.sub != ""
                text n.sub font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
      if found.tasks.length > 0
        text "Tasks" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for t in found.tasks key=t.id
          button press=openTask(t.listId, t.id) appearance="none" width="100%" text-align="start" padding="6px 8px" border-radius=8 testId=`found-task-${t.id}`
            column gap=1 min-width=0
              text t.title font-weight=600 line-clamp=1 text-decoration=(t.done ? "line-through" : "none")
              text t.sub font="-exact-footnote" color="-exact-secondary-label" line-clamp=1
      if found.events.length > 0
        text "Events" color="-exact-secondary-label" font="-exact-footnote" padding="6px 8px 2px"
        for e in found.events key=e.id
          button press=openEvent(e.id) appearance="none" width="100%" text-align="start" padding="6px 8px" border-radius=8 testId=`found-event-${e.id}`
            column gap=1 min-width=0
              text e.title font-weight=600 line-clamp=1
              text e.sub font="-exact-footnote" color="-exact-secondary-label" line-clamp=1

component NotifBell
  props
    count: number
  view
    if count > 0
      button popovertarget="notif-pop" aria-label=`Notifications, ${count} unread` testId="bell"
        view min-width=18 height=18 border-radius=9 background-color="-exact-system-red" display="flex" align-items="center" justify-content="center"
          text `${count}` color="#ffffff" font-size=11 font-weight=600
    else
      button popovertarget="notif-pop" aria-label="Notifications" testId="bell"
        image "symbol:notifications"

component ColorSwatches
  props
    color: string
    onColor: action
    prefix: string
  view
    row gap=8 flex-wrap="wrap"
      for c in colorPalette() key=c
        button press=onColor(c) aria-label=c testId=`${prefix}${c.slice(1).toLowerCase()}` width=30 height=30 border-radius=15 display="flex" align-items="center" justify-content="center" background-color=c
          if color.toLowerCase() == c.toLowerCase()
            image "symbol:checkmark" color="AccentColorText" width=14 height=14

// The calendars sheet. Each calendar is a section: a visibility checkbox, and a name row that opens
// the inline editor (name, colors, Save, Delete). The tasks calendar is visibility only.
component ManageCalendars
  props
    route: number
    calendars: CalendarItem[]
    editId: string
    editName: string
    editColor: string
    edit: action
    rename: action
    pickColor: action
    openMenu: action
    setVisible: action
    save: action
    askDelete: action
    done: action
    addSub: action
    syncNow: action
    error: string
    saving: bool
  view
    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
      text "Calendars" role="heading"
      button press=done buttonStyle="bordered-prominent" aria-label="Done" testId="manage-calendars-done"
        text "Done"
    list id="manage-calendars" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="100%"
      section
        row
          button press=addSub testId="add-subscription" flex=1
            row gap=10 align-items="center"
              image "symbol:add"
              text "Add Subscription…"
      for c in calendars key=c.id
        section
          row gap=10 align-items="center"
            if c.type == "tasks"
              view width=12 height=12 border-radius=6 background-color=dotOf(c.color)
              text c.name flex=1 min-width=0
            else
              button press=edit(c.id, c.name, c.color) aria-label=c.name testId=`cal-row-${c.id}` flex=1 min-width=0 contextPopover="cal-ctx-menu" contextmenu=openMenu(c.id)
                row gap=10 align-items="center"
                  view width=12 height=12 border-radius=6 background-color=dotOf(c.color)
                  column flex=1 min-width=0
                    text c.name
                    if c.syncKind != ""
                      text (c.syncError != "" ? c.syncError : c.syncKind == "caldav" ? "CalDAV · read-only" : "Web calendar · read-only") font="-exact-footnote" color=(c.syncError != "" ? "-exact-system-red" : "-exact-secondary-label") testId=`cal-sub-${c.id}`
            input type="checkbox" checked=c.isActive change=setVisible(c.id) aria-label=`Show ${c.name}` testId=`cal-visible-${c.id}` outline="none"
          if editId == c.id and c.type != "tasks"
            row
              input value=editName input=rename placeholder="Name" aria-label="Name" testId="cal-edit-name" flex=1 min-width=0 appearance="none" outline="none"
            ColorSwatches(color=editColor, onColor=pickColor, prefix="cal-color-")
            if error != "" and not saving
              row
                text error color="-exact-system-red" testId="cal-error"
            if c.syncKind != ""
              row
                button press=syncNow(c.id) buttonStyle="bordered" testId="cal-sync" flex=1
                  text "Sync Now"
            row gap=8
              button press=save disabled=(editName.trim() == "" or saving) buttonStyle="bordered-prominent" testId="cal-save" flex=1
                text "Save"
              button press=askDelete destructive=true testId="cal-delete" flex=1
                text (c.syncKind != "" ? "Unsubscribe" : "Delete Calendar")

// The event editor: one form for a new event (`creating`, a modal: one POST on Add) and an existing one
// (one PATCH on Save; Delete confirms). Rows are grouped like TaskEditor's: title and location; all-day and
// the start and end (date and time pickers); repeat and alert; calendar, URL and attendees; notes.
// The calendar takes events only from active, non-tasks calendars. A new event starts at the next full
// hour on the day the calendar opened on, and lasts an hour.
// Add a subscription: a web calendar link (iCloud public calendar, Google's secret iCal address, Outlook, any .ics)
// or a CalDAV account (iCloud, Fastmail, Nextcloud, ...): sign in, find its calendars, pick which to add.
component AddCalendar
  props
    route: number
    subscribe: action
    find: action
    toggle: action
    connect: action
    cancel: action
    found: Discovery
    finding: bool
    picked: string
    subscribing: bool
    subError: string
    findError: string
    connectError: string
  state mode = "link"
  state url = ""
  state name = ""
  state server = ""
  state user = ""
  state pass = ""
  action setMode(m: string)
    mode = m
  action editUrl(v: string)
    url = v
  action editName(v: string)
    name = v
  action editServer(v: string)
    server = v
  action editUser(v: string)
    user = v
  action editPass(v: string)
    pass = v
  action preset(u: string)
    server = u
  view
    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
      button press=cancel aria-label="Cancel" testId="add-calendar-cancel"
        image "symbol:close"
      text "Add Subscription" role="heading"
      view width=40
    list id="add-calendar" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="100%"
      section
        row gap=8
          button press=setMode("link") buttonStyle=(mode == "link" ? "bordered-prominent" : "bordered") testId="sub-mode-link" flex=1
            text "Web link"
          button press=setMode("account") buttonStyle=(mode == "account" ? "bordered-prominent" : "bordered") testId="sub-mode-account" flex=1
            text "Account"
      if mode == "link"
        section
          row
            input value=url input=editUrl placeholder="webcal:// or https:// link" aria-label="Calendar link" type="url" autocapitalize="none" autocorrect="off" testId="sub-url" flex=1 min-width=0 appearance="none" outline="none"
          row
            input value=name input=editName placeholder="Name (optional)" aria-label="Name" testId="sub-name" flex=1 min-width=0 appearance="none" outline="none"
        section
          row
            text "iCloud: share the calendar with Public Calendar on and copy the link. Google: Settings, the calendar, Secret address in iCal format. Outlook: Publish calendar, ICS link." font="-exact-footnote" color="-exact-secondary-label"
        if subError != ""
          section
            row
              text subError color="-exact-system-red" testId="sub-error"
        section
          row
            button press=subscribe(url, name, "", "") disabled=(url.trim() == "" or subscribing) buttonStyle="bordered-prominent" testId="sub-add" flex=1
              text (subscribing ? "Subscribing…" : "Subscribe")
      else
        section
          row gap=8
            button press=preset("https://caldav.icloud.com") buttonStyle="bordered" testId="sub-preset-icloud" flex=1
              text "iCloud"
            button press=preset("https://caldav.fastmail.com") buttonStyle="bordered" testId="sub-preset-fastmail" flex=1
              text "Fastmail"
            button press=preset("https://caldav.calendar.yahoo.com") buttonStyle="bordered" testId="sub-preset-yahoo" flex=1
              text "Yahoo"
        section
          row
            input value=server input=editServer placeholder="Server address" aria-label="Server" type="url" autocapitalize="none" autocorrect="off" testId="sub-server" flex=1 min-width=0 appearance="none" outline="none"
          row
            input value=user input=editUser placeholder="Username" aria-label="Username" autocapitalize="none" autocorrect="off" testId="sub-user" flex=1 min-width=0 appearance="none" outline="none"
          row
            input value=pass input=editPass type="password" placeholder="Password" aria-label="Password" testId="sub-pass" flex=1 min-width=0 appearance="none" outline="none"
        section
          row
            column gap=6 align-items="flex-start"
              text "iCloud needs an app-specific password, not your Apple ID password. Google does not offer CalDAV to passwords: use its secret iCal address under Web link." font="-exact-footnote" color="-exact-secondary-label"
              link href="https://account.apple.com/account/manage/section/security" testId="sub-apple-password"
                text "Create an Apple app-specific password" font="-exact-footnote"
        if findError != ""
          section
            row
              text findError color="-exact-system-red" testId="sub-find-error"
        section
          row
            button press=find(server, user, pass) disabled=(server.trim() == "" or user == "" or pass == "" or finding) buttonStyle="bordered" testId="sub-find" flex=1
              text (finding ? "Looking…" : "Find Calendars")
        if found.found.length > 0
          section
            for f in found.found key=f.url
              row gap=10 align-items="center"
                view width=12 height=12 border-radius=6 background-color=dotOf(f.color)
                text f.name flex=1 min-width=0
                input type="checkbox" checked=picked.split("\n").includes(f.url) change=toggle(f.url) aria-label=`Add ${f.name}` testId=`sub-pick-${f.name}` outline="none"
          if connectError != ""
            section
              row
                text connectError color="-exact-system-red" testId="sub-error"
          section
            row
              button press=connect(server, user, pass) disabled=(picked == "" or subscribing) buttonStyle="bordered-prominent" testId="sub-connect" flex=1
                text (subscribing ? "Adding…" : "Add Selected")

component EventEditor
  props
    route: number
    ev: EventRow
    creating: bool
    calendars: CalendarItem[]
    initialDay: string
    today: string
    nowMs: number
    offset: number
    save: action
    remove: action
    cancel: action
    error: string
    saving: bool
  action noCode
    notes = notes
  action noExtra(v: string)
    notes = notes
  state title = ev.title
  state notes = ev.description
  state url = ev.url
  state location = ev.location
  state allDay = ev.allDay
  state startDay = creating ? (initialDay == today ? formatDate(nextHour(nowMs, offset), offset, "iso") : initialDay) : ev.startDay
  state startTime = creating ? hhmm(nextHour(nowMs, offset), offset) : ev.startClock
  state endDay = creating ? (initialDay == today ? formatDate(nextHour(nowMs, offset) + 3600000, offset, "iso") : initialDay) : ev.endDay
  state endTime = creating ? hhmm(nextHour(nowMs, offset) + 3600000, offset) : ev.endClock
  state repeatSel = repeatOf(ev.recurrence)
  state alertSel = alertOf(ev.alertMinutes)
  state attendeesText = ev.attendees.join(", ")
  state calSel = ""
  derive choices = calendars.filter(c => c.type != "tasks" and c.isActive and c.syncKind == "")
  derive readOnly = not creating and calOf(calendars, ev.calendarId).syncKind != ""
  derive firstChoice = match first(choices) { case some(c) => c.id, case none => "" }
  derive calNow = creating ? (calSel == "" ? firstChoice : calSel) : ev.calendarId
  derive parsedAttendees = attendeesText.split(",").map(a => a.trim()).filter(a => a.includes("@"))
  action editTitle(v: string)
    title = v
  action editNotes(v: string)
    notes = v
  action editUrl(v: string)
    url = v
  action editLocation(v: string)
    location = v
  action toggleAllDay(on: bool)
    allDay = on
  // The end never falls before the start. Moving the start time on the end's day moves the end by the same
  // minutes (the duration holds); moving the start day pulls the end day and time up to it.
  action editStartDay(v: string)
    startDay = v
    let end = endDay < v ? v : endDay
    endDay = end
    if end == v and endTime < startTime
      endTime = startTime
  action editStartTime(v: string)
    let d = minutesOf(v) - minutesOf(startTime)
    if endDay == startDay
      endTime = movedEnd(endTime, d, v)
    startTime = v
  action editEndDay(v: string)
    endDay = v
  action editEndTime(v: string)
    endTime = v
  action pickRepeat(v: string)
    repeatSel = v
  action pickAlert(v: string)
    alertSel = v
  action pickCal(v: string)
    calSel = v
  action editAttendees(v: string)
    attendeesText = v
  state fmtFormats = ""
  state fmtUnavailable = ""
  state fmtLink = ""
  action selectedFmt(s)
    fmtFormats = s.formats
    fmtUnavailable = s.unavailable
    fmtLink = s.link
  // Native format bar (as in NoteEditor): the hatch sends "platform:ios" and "cmd:<name>:<n>" through the hidden bridge.
  state nativeBar = false
  state bridgeValue = ""
  action bridgeInput(v: string)
    bridgeValue = v
    if v == "platform:ios"
      nativeBar = true
    else if v.startsWith("link:")
      format("event-notes", "link", v.split(":").slice(2).join(":"))
    else if v.startsWith("cmd:")
      match v.slice(4).split(":").at(0)
        case some(c)
          nativeCmd(c)
        case none
          bridgeValue = ""
  // Taps on the empty part of the notes row: focus the field with the caret at its end.
  action focusNotes
    focus("event-notes")
    setSelectionRange("event-notes", notes.length, notes.length)
  action nativeCmd(name: string)
    if name == "heading"
      format("event-notes", "heading", "2")
    else if name == "dismiss"
      blur("event-notes")
    else
      format("event-notes", name)
  view
    header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
      if creating
        button id="back" press=cancel aria-label="Cancel" testId="new-event-cancel"
          image "symbol:close"
      text (creating ? "New Event" : "Event") role="heading" aria-level=2 flex="1 1 6rem"
      button press=save(creating ? "" : ev.id, calNow, title, notes, url, location, allDay, startDay, startTime, endDay, endTime, repeatSel, alertSel, parsedAttendees) disabled=(title.trim() == "" or calNow == "" or saving or readOnly) buttonStyle="bordered-prominent"
        aria-label=(creating ? "Add" : "Save") testId=(creating ? "new-event-add" : "event-save")
        image "symbol:checkmark"
    list id="event-edit" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
      section
        row
          input value=title input=editTitle placeholder="Title" aria-label="Title" autofocus=creating enterkeyhint="next" testId="event-title" flex=1 min-width=0 appearance="none" outline="none"
          input hatch="formatbar" data-role="bridge" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink value=bridgeValue input=bridgeInput aria-hidden=true testId="event-notes-bridge" position="absolute" width="0.1rem" height="0.1rem" opacity=0 pointer-events="none" outline="none"
        row
          input value=location input=editLocation placeholder="Location" aria-label="Location" testId="event-location" flex=1 min-width=0 appearance="none" outline="none"
      section
        row gap=8 align-items="center"
          text "All-day" flex=1 min-width=0
          input type="checkbox" switch checked=allDay change=toggleAllDay aria-label="All-day" testId="event-allday" outline="none"
        row gap=8 align-items="center"
          text "Starts" flex=1 min-width=0
          input type="date" value=startDay input=editStartDay aria-label="Start date" testId="event-start-day" flex=1 min-width=0 outline="none"
        if not allDay
          row
            input type="time" value=startTime input=editStartTime aria-label="Start time" testId="event-start-time" flex=1 min-width=0 outline="none"
        row gap=8 align-items="center"
          text "Ends" flex=1 min-width=0
          input type="date" value=endDay input=editEndDay aria-label="End date" testId="event-end-day" flex=1 min-width=0 outline="none"
        if not allDay
          row
            input type="time" value=endTime input=editEndTime aria-label="End time" testId="event-end-time" flex=1 min-width=0 outline="none"
      section
        row gap=8 align-items="center"
          text "Repeat" flex=1 min-width=0
          select value=repeatSel change=pickRepeat aria-label="Repeat" testId="event-repeat" flex=1 min-width=0
            option "Never" value="none"
            option "Daily" value="daily"
            option "Weekly" value="weekly"
            option "Every 2 Weeks" value="biweekly"
            option "Monthly" value="monthly"
            option "Yearly" value="yearly"
        row gap=8 align-items="center"
          text "Alert" flex=1 min-width=0
          select value=alertSel change=pickAlert aria-label="Alert" testId="event-alert" flex=1 min-width=0
            option "None" value="none"
            option "At time" value="0"
            option "5 minutes before" value="5"
            option "15 minutes before" value="15"
            option "1 hour before" value="60"
            option "1 day before" value="1440"
      section
        if creating
          row gap=8 align-items="center"
            text "Calendar"
            view width=10 height=10 border-radius=5 flex-shrink=0 background-color=calColor(calendars, calNow)
            select value=calNow change=pickCal aria-label="Calendar" testId="event-calendar" flex=1 min-width=0
              for c in choices key=c.id
                option c.name value=c.id
        else
          row gap=8 align-items="center"
            text "Calendar" flex=1 min-width=0
            view width=10 height=10 border-radius=5 flex-shrink=0 background-color=calColor(calendars, calNow)
            text calOf(calendars, calNow).name color="-exact-secondary-label" testId="event-calendar" flex=1 min-width=0
        row
          input type="url" value=url input=editUrl placeholder="URL" aria-label="URL" testId="event-url" flex=1 min-width=0 appearance="none" outline="none"
        row
          input value=attendeesText input=editAttendees placeholder="Attendees, comma, separated" aria-label="Attendees" appearance="none" outline="none"
            inputmode="email" testId="event-attendees" flex=1 min-width=0
      section
        row press=focusNotes
          textarea id="event-notes" value=notes input=editNotes placeholder="Notes" aria-label="Notes"
            hatch="formatbar" data-role="editor" data-images="0" data-formats=fmtFormats data-unavailable=fmtUnavailable data-link=fmtLink
            markup="markdown" rows=6 testId="event-notes" flex=1 min-width=0 width="100%" max-width="100%" white-space="pre-wrap" overflow-wrap="anywhere" outline="none" field-sizing="content" overflow-y="hidden" min-height="8rem" padding="8px 0" select=selectedFmt
        row display=(nativeBar ? "none" : "flex") padding-top=8 padding-bottom=8
          MarkdownToolbar(editor="event-notes", prefix="efmt", formats=fmtFormats, unavailable=fmtUnavailable, link=fmtLink, imageInput="", collapsed=false, codeHere=noCode, extras=false, extra=noExtra, imageLine=false, imageHref="", imageLink=noExtra)
      if error != "" and not saving
        section
          row
            text error color="-exact-system-red" testId="event-error"
      if readOnly
        section
          row
            text "This event comes from a subscribed calendar, so it is read-only." font="-exact-footnote" color="-exact-secondary-label" testId="event-readonly"
      if not creating and not readOnly
        section
          row
            button press=remove destructive=true testId="event-delete" flex=1
              text "Delete Event"

// Markdown formatting toolbar (rich-text.md, Phase 3). `editor` is the
// textarea's id; `formats`, `unavailable` and `link` come from that
// textarea's `select` (a MarkdownSelection). Buttons keep focus (retainFocus),
// so the editor keeps its selection. Inside a horizontal scroller, so a narrow
// screen scrolls the row rather than wrapping or overflowing it.
component MarkdownToolbar
  props
    editor: string
    prefix: string
    formats: string
    unavailable: string
    link: string
    imageInput: string
    collapsed: bool
    codeHere: action
    extras: bool
    extra: action
    imageLine: bool
    imageHref: string
    imageLink: action
  state linkOpen = false
  state linkUrl = ""
  derive headingOn = ` ${formats} `.includes(" heading2 ")
  derive headingOff = ` ${unavailable} `.includes(" heading ")
  derive linkOn = ` ${formats} `.includes(" link ")
  derive linkOff = ` ${unavailable} `.includes(" link ") and not imageLine
  // Code with nothing selected would leave an empty pair whose caret the editor draws outside it, so
  // the owner puts `code` between the ticks, selected, for the person to type over.
  action fmt(command: string)
    if command == "code" and collapsed and not ` ${formats} `.includes(" code ")
      codeHere()
    else if command == "rule"
      extra(command)
    else
      format(editor, command)
  action fmtHeading(level: string)
    format(editor, "heading", level)
  action pickImage
    showPicker(imageInput)
  action openLink
    linkUrl = imageLine ? imageHref : link
    linkOpen = true
    focus(`${prefix}-link-url`)
  action linkChanged(value: string)
    linkUrl = value
  action applyLink
    if imageLine
      imageLink(linkUrl)
    else
      format(editor, "link", linkUrl)
    linkOpen = false
    focus(editor)
  action cancelLink
    linkOpen = false
    focus(editor)
  view
    column width="100%" gap=6 box-sizing="border-box"
      scroll overflow-x="auto" overflow-y="hidden" width="100%" testId=`${prefix}-toolbar`
        row role="toolbar" aria-label="Markdown formatting" gap=2 align-items="center"
          FmtTool(name="bold", icon="M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8", aria="Bold", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="italic", icon="M19 4h-9M14 20H5M15 4 9 20", aria="Italic", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="strike", icon="M16 4H9a3 3 0 0 0-2.83 4M14 12a4 4 0 0 1 0 8H6M4 12h16", aria="Strikethrough", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="code", icon="m16 18 6-6-6-6M8 6l-6 6 6 6", aria="Code", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
          for lv in ["1", "2", "3", "4"] key=lv
            button appearance="none" press=fmtHeading(lv) retainFocus=true testId=`${prefix}-h${lv}` aria-label=(` ${formats} `.includes(` heading${lv} `) ? `Heading ${lv} active` : `Heading ${lv}`) disabled=headingOff
              flex-shrink=0 width=34 height=36 border-radius=8 display="flex" align-items="center" justify-content="center"
              color=(` ${formats} `.includes(` heading${lv} `) ? "-exact-link" : "-exact-label") background-color=(` ${formats} `.includes(` heading${lv} `) ? "light-dark(#e5efff, #1d3045)" : "transparent") opacity=(headingOff ? 0.35 : 1)
              text `H${lv}` font-size=14 font-weight=700
          view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
          FmtTool(name="bullet", icon="M3 12h.01M3 18h.01M3 6h.01M8 12h13M8 18h13M8 6h13", aria="Bullet list", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="ordered", icon="M10 12h11M10 18h11M10 6h11M4 10h2M4 6h1v4M6 18H4c0-1 2-2 2-3s-1-1.5-2-1", aria="Numbered list", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="task", icon="m3 17 2 2 4-4M3 7l2 2 4-4M13 6h8M13 12h8M13 18h8", aria="Task list", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
          FmtTool(name="quote", icon="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2zM5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z", aria="Quote", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="codeblock", icon="m10 9-3 3 3 3M14 15l3-3-3-3M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z", aria="Code block", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
          button appearance="none" press=openLink retainFocus=true testId=`${prefix}-link` aria-label=(linkOn ? "Link active" : "Link") disabled=linkOff
            flex-shrink=0 width=36 height=36 border-radius=8 display="flex" align-items="center" justify-content="center"
            color=(linkOn ? "-exact-link" : "-exact-label") background-color=(linkOn ? "light-dark(#e5efff, #1d3045)" : "transparent") opacity=(linkOff ? 0.35 : 1)
            svg viewBox="0 0 24 24" width=20 height=20
              path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" fill="none" stroke="currentcolor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
          view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
          if extras
            FmtTool(name="rule", icon="M3 12h18M8 8l4-4 4 4M16 16l-4 4-4-4", aria="Horizontal divider", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="outdent", icon="M7 8l-4 4 4 4M21 12H11M21 6H11M21 18H11", aria="Outdent", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          FmtTool(name="indent", icon="M3 8l4 4-4 4M21 12H11M21 6H11M21 18H11", aria="Indent", prefix=prefix, formats=formats, unavailable=unavailable, apply=fmt)
          if imageInput != ""
            view width=0 height=20 flex-shrink=0 margin="0px 4px" border-left="1px solid -exact-separator"
            button appearance="none" press=pickImage aria-label="Add Image" testId="note-image"
              flex-shrink=0 width=36 height=36 border-radius=8 display="flex" align-items="center" justify-content="center" color="-exact-label"
              svg viewBox="0 0 24 24" width=20 height=20
                path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM21 15l-3.09-3.09a2 2 0 0 0-2.82 0L6 21M11 9a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" fill="none" stroke="currentcolor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      if linkOpen
        row gap=6 align-items="center" width="100%"
          input id=`${prefix}-link-url` value=linkUrl input=linkChanged submit=applyLink aria-label="Link URL" placeholder="https://example.com" testId=`${prefix}-link-url` flex=1 min-width=0 padding=8 appearance="none" outline="none"
          button appearance="none" press=applyLink retainFocus=true testId=`${prefix}-link-apply` min-height=40 padding=8
            text (linkUrl == "" ? "Remove link" : "Apply") font-size=13
          button appearance="none" press=cancelLink testId=`${prefix}-link-cancel` min-height=40 padding=8
            text "Cancel" font-size=13

// One command button of MarkdownToolbar: `apply(name)` runs the command, and
// the button shows active while the selection has it and is off while it cannot apply.
component FmtTool
  props
    name: string
    icon: string
    aria: string
    prefix: string
    formats: string
    unavailable: string
    apply: action
  derive on = ` ${formats} `.includes(` ${name} `)
  derive off = ` ${unavailable} `.includes(` ${name} `)
  view
    button appearance="none" press=apply(name) retainFocus=true testId=`${prefix}-${name}` aria-label=(on ? `${aria} active` : aria) disabled=off
      flex-shrink=0 width=36 height=36 border-radius=8 display="flex" align-items="center" justify-content="center"
      color=(on ? "-exact-link" : "-exact-label") background-color=(on ? "light-dark(#e5efff, #1d3045)" : "transparent") opacity=(off ? 0.35 : 1)
      svg viewBox="0 0 24 24" width=20 height=20
        path d=icon fill="none" stroke="currentcolor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
