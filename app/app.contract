                      input value=styleNameDraft input=editStyleName submit=submitStyleName placeholder="Section name" aria-label="Section name" appearance="none" testId="section-style-name" border="1px solid light-dark(#c6c6c8, #48484a)" border-radius=10 padding="8px 10px" outline="none"
                      IconColorPicker(icon=styleSection.icon, color=styleSection.color, paths=iconPathsOf(styleSection.icon, fetchedIcons), query=iconQuery, hits=iconHits.names, queryEdit=editIconQuery, onIcon=pickSectionIcon, onColor=pickSectionColor, onNone=clearSectionStyle)
