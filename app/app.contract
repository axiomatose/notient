                          button press=ctxPriority(1) aria-checked=(ctxRow.priority == 1) popovertarget="task-menu" popovertargetaction="hide" testId="ctx-priority-1"
                            text "Low"
                          button press=ctxPriority(2) aria-checked=(ctxRow.priority == 2) popovertarget="task-menu" popovertargetaction="hide" testId="ctx-priority-2"
                            text "Medium"
                          button press=ctxPriority(3) aria-checked=(ctxRow.priority == 3) popovertarget="task-menu" popovertargetaction="hide" testId="ctx-priority-3"
                            text "High"
                      hr
                      if memberList.length > 0
                        column role="group" aria-label="Assign to"
