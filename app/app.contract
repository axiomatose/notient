  action toggleFolderOpen(f: string)
    shutFolders = folderShut(shutFolders, f) ? shutFolders.split("|").filter(x => x != f).join("|") : (shutFolders == "" ? f : shutFolders + "|" + f)
  action setSort(v: string)
    noteSort = v
  // A new note is the full editor on a blank draft: the server creates it when there is something to keep
