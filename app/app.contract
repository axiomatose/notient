                button press=crumbHome appearance="none" pointer-events="auto" testId="crumb-folder"
                  text crumbFolder font="-exact-subheadline" color="-exact-secondary-label"
                text "/" color="-exact-secondary-label" font="-exact-subheadline"
                text crumbLeaf font="-exact-subheadline" testId="crumb-leaf" line-clamp=1 min-width=0
                text "/" color="-exact-secondary-label" font="-exact-subheadline"
                button press=crumbMode appearance="none" pointer-events="auto" testId="crumb-mode"
                  text (editorMode == "edit" ? "Edit" : "View") font="-exact-subheadline" color="AccentColor"
          // Centered over the page below the sidebar, under the page's own header buttons on the right.
          row position="absolute" top=0 left=(sideOpen ? "calc(23rem + (100% - 23rem) / 2)" : "50%") transform="translateX(-50%)" width="min(18rem, 30%)" height=44 align-items="center" padding-top=8 box-sizing="border-box" z-index=9
            input type="search" value=searchQ input=runSearch placeholder="Search everything" aria-label="Search everything" testId="search-all" pointer-events="auto" appearance="none" width="100%" box-sizing="border-box" padding="5px 10px" border="1px solid light-dark(#d1d1d6, #3a3a3c)" border-radius=8 background-color="light-dark(#f2f2f7, #2c2c2e)" outline="none"
            if searchQ.trim() != ""
              column position="absolute" top=44 left=0 width="26rem" max-width="90vw" max-height="70vh" overflow-y="auto" pointer-events="auto" z-index=30 box-sizing="border-box" padding=8 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" testId="search-pop"
                SearchResults(q=searchQ, found=found, busy=pending(found), openNote=openFoundNote, openTask=openFoundTask, openEvent=openFoundEvent, openFolder=openFoundFolder, openList=openFoundList)
        if sideOpen
          DesktopSidebar(serverHost=serverCheck.host, serverState=serverCheck.state, current=nav.tab, selected=selectedNote, signedIn=session.signedIn, shown=shown, email=session.email, unread=unreadCount, notes=sideNotes, noteFolders=sectionFolders, query="", tasks=recentTaskRows, events=recentEventRows, lists=(listsSame ? lists.lists : []), folders=(foldersSame ? taskFolders.folders : []), notesOpen=sideNotesOpen, notesTall=sideNotesTall, tasksOpen=sideTasksOpen, tasksTall=sideTasksTall, openedRows=sideOpened, openListId=openList, folderDraft=folderDraft, folderError=(pending(folderAdded) ? "" : folderError), avatarUrl=avatarUrl, avatarIcon=avatarIcon, avatarColor=avatarColor, fetched=fetchedIcons, pick=pick, openListMenu=openListMenu, openNote=openSideNote, openNoteMenu=openNoteMenu, openEventMenu=openEventMenu, openTask=openRecentTask, openList=openSideList, addTask=openNewTaskIn, search=runSearch, newNote=openNewNote, trash=openTrash, newList=openNewList, editFolder=editFolderDraft, addFolder=addFolder, toggleNotes=toggleSideNotes, toggleNotesTall=toggleSideNotesTall, toggleTasks=toggleSideTasks, toggleTasksTall=toggleSideTasksTall, toggleFold=toggleSideFold, newFolder=openNewFolder)
      column flex=1 min-width=0 min-height=0 position="relative" margin-top=0
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "notes"
                if not session.signedIn
                  column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 display="flex" flex-direction="column"
                    SignIn(error=authError, pendingAuth=(pending(authReply)), signIn=doSignIn, register=doRegister, server=serverAddr.server, fallback=serverAddr.fallback, saved=serverAddr.saved, registration=authOptions.registration, demoEmail=authOptions.demoEmail, demoPassword=authOptions.demoPassword, saveServer=doServer, serverError=serverError, eyePaths=eyePaths, eyeOffPaths=eyeOffPaths)
                else if wide
                  column navigationKey=`${e.id}` navigationBar=(wide ? "none" : "auto") box-sizing="border-box" padding-top=(wide ? 44 : 0) position="absolute" inset=0 display="flex" flex-direction="column" testId="notes-pane"
                    if sideNotes.length == 0
                      scroll flex=1 min-height=0
                        column width="min(60rem, calc(100% - 3rem))" margin="0 auto" padding="32px 0px" gap=24 testId="notes-recent"
