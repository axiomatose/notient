                                button press=openBoardCol(col) appearance="none" aria-label=`Open ${boardName(sections.sections, noneName, col)}` testId=`board-open-${col}` flex-shrink=0 width="100%" display="flex" flex-direction="column" align-items="center" gap=6 padding="2px 0"
                                  if sectionOf(sections.sections, col).icon != ""
