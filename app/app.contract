  action openLightbox(url: string, set: string)
    lightboxUrl = url
    lightboxSet = set
    showModal("lightbox")
  // The images the lightbox pages through (the note's or the task's), and where the shown one sits.
  derive lightboxList = lightboxSet.split("\n").filter(u => u != "")
  derive lightboxAt = match lightboxList.map((u, k) => u == lightboxUrl ? k : -1).filter(k => k >= 0).at(0) { case some(k) => k, case none => 0 }
  action lightboxStep(d: number)
    let n = lightboxList.length
    if n > 1
      lightboxUrl = match lightboxList.at((lightboxAt + d + n) % n) { case some(u) => u, case none => lightboxUrl }
  action lightboxGo(u: string)
    lightboxUrl = u
  // A task from the sidebar: its list opens under the Tasks tab (the detail reads that list), then the task.
