          row width=(sideOpen ? "23rem" : "auto") height=44 flex-shrink=0 align-items="center" gap=6 box-sizing="border-box" padding-top=8 padding-left="calc(env(titlebar-area-x, 0px) + 8px)" padding-right=12 background-color=(sideOpen ? "light-dark(#eef1f6, #1a1c21)" : "transparent") testId="titlebar-left"
            button press=toggleSidebar appearance="none" pointer-events="auto" aria-label="Toggle the sidebar" testId="sidebar-toggle" width=28 height=28 display="flex" align-items="center" justify-content="center"
              LucideIcon(paths=["M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z", "M9 3v18"], color="-exact-secondary-label", size=18)
            text "Notient" font="-exact-headline"
