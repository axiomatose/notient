                text "/" color="-exact-secondary-label" font="-exact-subheadline"
                text crumbLeaf font="-exact-subheadline" testId="crumb-leaf" line-clamp=1 min-width=0
            else if nav.tab == "notes"
              button press=crumbHome appearance="none" pointer-events="auto" testId="crumb-section" padding="2px 8px" border-radius=6 background-color=(crumbOnNote ? "transparent" : "light-dark(#e3ecfb, #2a3a55)")
                text "Notes" color="AccentColor" font="-exact-subheadline"
