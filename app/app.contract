  // Templates: a note's name when saved, a line of confirmation for a few seconds, the template waiting on delete.
  state templateNotice = ""
  state templateDelete = ""
  // Phone dropdown: the open tab's templates, narrowed by a search box once there are more than six.
  state tplQuery = ""
  action setTplQuery(v: string)
    tplQuery = v
  derive tplAll = nav.tab == "tasks" ? templates.lists : templates.notes
  derive tplShown = tplAll.filter(t => tplQuery.trim() == "" or t.name.toLowerCase().includes(tplQuery.trim().toLowerCase()))
  task templateNoticeShown when templateNotice != "" key=templateNotice
    after(4000, clearTemplateNotice)
  action clearTemplateNotice
    templateNotice = ""
  action openNoteFromTemplate(title: string, body: string)
    noteChromeHidden = false
    noteLastY = 0
    editorNoteId = ""
    editorTitle = title
    editorBody = body
    editorFolder = ""
    editorTagsText = ""
    editorPinned = false
    savedTitle = ""
    savedBody = ""
    savedFolder = ""
    savedTags = ""
    savedPinned = false
    editorMode = "edit"
    lastEdit = performanceNow()
    nav = wide ? open(nav, "/new") : push(nav, "/new")
  action saveNoteAsTemplate
    if (editorTitle.trim() != "" or editorBody.trim() != "") and not pending(templateSaved)
      templateNotice = `Saved “${editorTitle.trim() == "" ? "Untitled" : editorTitle.trim()}” as a template`
      send templateSaved = saveNoteTemplate(editorTitle.trim() == "" ? "Untitled" : editorTitle.trim(), editorTitle, editorBody)
  action saveListAsTemplate
    if openList != "" and not pending(templateSaved)
      templateNotice = `Saved “${listName(allLists, openList)}” as a template`
      send templateSaved = saveListTemplate(openList, listName(allLists, openList))
  // Files dropped on the window: images go to the open note or task, Markdown and text files (and folders of them) become notes.
  state dropOver = false
  action dropEntered
    dropOver = true
  action dropLeft
    dropOver = false
  action filesDropped(e: DragEvent)
    dropOver = false
    let imgs = e.files.filter(p => isImagePath(p))
    let rest = e.files.filter(p => not isImagePath(p))
    if imgs.length > 0 and crumbOnNote and not pending(noteImage)
      imageChosen(imgs.map(p => lastSegment(p)).join("\n"), imgs.join("\n"), "")
    else if imgs.length > 0 and openTask != "" and not pending(taskImageR)
      send taskImageR = uploadTaskImages(openTask, imgs.map(p => lastSegment(p)).join("\n"), imgs.join("\n"))
    if rest.length > 0 and not pending(notesImported)
      send notesImported = importNotes(rest.join("\n"))
  action afterImport
    match notesImported
      case some(r)
        templateNotice = r.ok ? `Imported ${r.imported} note${r.imported == 1 ? "" : "s"}${r.skipped > 0 ? `, skipped ${r.skipped}` : ""}` : `Couldn’t import. (${r.error})`
      case none
        templateNotice = templateNotice
  // Export: one note, one folder (with its subfolders) or the whole library, downloaded then handed to the save panel.
  action exportNow(kind: string, id: string, folder: string, name: string, vaults: bool)
    if not pending(exportMade)
      templateNotice = "Preparing the export…"
      send exportMade = exportNotes(kind, id, folder, name, vaults)
  action exportThisNote
    if editorNoteId != ""
      exportNow("note", editorNoteId, "", editorTitle.trim() == "" ? "Untitled" : editorTitle.trim(), true)
  // A folder or the library asks first whether vault notes come along (they leave out otherwise, and are named vault-…).
  state exportKind = ""
  state exportVaults = false
  action exportShown
    exportKind = folderFilter != "" ? "folder" : "library"
    exportVaults = false
    showModal("export-options")
  action exportLibrary
    exportKind = "library"
    exportVaults = false
    showModal("export-options")
  action setExportVaults(v: bool)
    exportVaults = v
  action confirmExport
    if exportKind == "folder"
      exportNow("folder", "", folderFilter, lastSegment(folderFilter), exportVaults)
    else
      exportNow("library", "", "", "Notient notes", exportVaults)
  action afterExport
    match exportMade
      case some(r)
        if r.ok
          templateNotice = `Exported ${r.count} note${r.count == 1 ? "" : "s"}${r.skipped > 0 ? `; left out ${r.skipped} vault note${r.skipped == 1 ? "" : "s"}` : ""}`
          saveFile("export-save", r.path, r.name)
        else
          templateNotice = `Couldn’t export. (${r.error})`
      case none
        templateNotice = templateNotice
  // A new folder is made from the notes home, so it can exist before a note is filed in it; the parent is optional.
  action openNewFolder
    newFolderName = ""
    newFolderParent = folderFilter == "" ? "-" : folderFilter
    showModal("new-folder")
  action editNewFolderName(v: string)
    newFolderName = v
  action pickNewFolderParent(v: string)
    newFolderParent = v
  action createFolder
    if newFolderName.trim() != "" and not pending(folderMade)
      send folderMade = makeNoteFolder(newFolderName.trim(), newFolderParent == "-" ? "" : newFolderParent)
  action afterFolderMade
    match folderMade
      case some(r)
        if not r.ok
          templateNotice = `Couldn’t make the folder. (${r.error})`
      case none
        templateNotice = templateNotice
  action afterTemplateSaved
    match templateSaved
      case some(r)
        if not r.ok
          templateNotice = `Couldn’t save the template. (${r.error})`
      case none
        templateNotice = templateNotice
  action newListFromTemplate(name: string, json: string)
    if not pending(listMade)
      send listMade = makeListFromTemplate(name, json)
  action afterListMade
    match listMade
      case some(r)
        if r.ok
          nav = open(nav, path("taskList", r.id))
        else
          templateNotice = `Couldn’t start the list. (${r.error})`
      case none
        templateNotice = templateNotice
  action askDeleteTemplate(id: string)
    templateDelete = id
    showModal("delete-template")
  action deleteTemplateNow
    send templateDeleted = deleteTemplate(templateDelete)
    templateDelete = ""
  action openNewList
    iconQuery = ""
    if wide
      openSheet("newList", "")
    else
      nav = push(nav, "/new-list")
  action createListNow(id: string, name: string, folderId: string, icon: string, color: string, grocery: bool)
    if name.trim() != "" and not pending(listAdded)
      send listAdded = createList(name.trim(), folderId, icon, color, grocery)
  action afterListAdd
    if listError == "" and sheet == "newList"
      closeSheet()
    if listError == "" and top(nav).name == "newList"
      nav = back(nav)
  action openListQuick
    listQuickOpen = true
  // The keyboard's own checkmark/Return can resign the field right after it submits: that blur is not a cancel.
  // The box resets and stays for the next item (a grocery run), and takes the keyboard back a beat later.
  state listQuickSubmitting = false
  // Each added item rebuilds the field (a new generation), which takes the keyboard on its autofocus: focus()
  // on the old field does not bring it back once Return/checkmark has resigned it.
  state listQuickGen = 0
  action cancelListQuick
    if not listQuickSubmitting
      listQuickOpen = false
      listQuickDraft = ""
  action editListQuickTitle(v: string)
    listQuickDraft = v
  action addListQuickTask
    if listQuickDraft.trim() != "" and openList != "" and not pending(listQuickAdded)
      listQuickSubmitting = true
      send listQuickAdded = createTask(openList, "", listQuickDraft.trim())
      listQuickDraft = ""
  action afterListQuickAdd
    listQuickSubmitting = false
    listQuickDraft = ""
    let next = listQuickGen + 1
    listQuickGen = next
  action openSectionAdd(key: string)
    sectionAdding = key
    sectionTaskDraft = ""
  action editSectionTaskDraft(v: string)
    sectionTaskDraft = v
  action addSectionTask
    if sectionTaskDraft.trim() != "" and openList != "" and sectionAdding != "" and not pending(sectionTaskAdded)
      send sectionTaskAdded = createTask(openList, sectionAdding == "none" ? "" : sectionAdding, sectionTaskDraft.trim())
  action afterSectionTaskAdd
    if sectionTaskError == ""
      sectionTaskDraft = ""
      focus("section-add-input")
  action cancelSectionAdd
    sectionAdding = ""
    sectionTaskDraft = ""
  action openSectionRename(id: string, name: string)
    sectionRenaming = id
    sectionRenameDraft = name
  action editSectionRename(v: string)
    sectionRenameDraft = v
  action submitSectionRename
    let name = sectionRenameDraft.trim()
    if sectionRenaming == "none"
      if name == noneName or pending(noneRenamed)
        sectionRenaming = ""
      else
        send noneRenamed = renameUncategorized(openList, name == "Uncategorized" ? "" : name)
    else if name == "" or name == boardName(sections.sections, noneName, sectionRenaming)
      sectionRenaming = ""
    else if not pending(sectionRenamed)
      send sectionRenamed = renameSection(openList, sectionRenaming, name)
  action afterSectionRename
    if sectionRenameError == ""
      sectionRenaming = ""
  action afterNoneRename
    sectionRenaming = ""
  action cancelSectionRename
    sectionRenaming = ""
  action editStyleName(v: string)
    styleNameDraft = v
  action submitStyleName
    let name = styleNameDraft.trim()
    if styleSectionId == "none"
      if name != noneName and not pending(noneRenamed)
        send noneRenamed = renameUncategorized(openList, name == "Uncategorized" ? "" : name)
    else if name != "" and name != boardName(sections.sections, noneName, styleSectionId) and not pending(sectionRenamed)
      send sectionRenamed = renameSection(openList, styleSectionId, name)
  action aiInput(v: string)
    aiValue = v
    if v.startsWith("ai:ready:")
      aiStatus = v.slice(9)
    else if v.startsWith("ai:sorted:")
      aiBusy = false
      send tasksSorted = sortTasks(openList, v.split(":").slice(3).join(":"))
    else if v.startsWith("ai:error:")
      aiBusy = false
      aiNotice = v.split(":").slice(3).join(":")
  action sortByAisle
    if aiStatus != "ok"
      showModal("ai-unavailable")
    else if not aiBusy
      let next = aiCount + 1
      aiCount = next
      aiBusy = true
      aiNotice = ""
      aiRequest = `${next}\n` + tasks.tasks.filter(x => not x.isDone).map(x => `${x.id}\t${x.title}`).join("\n")
  action editDoneQuery(v: string)
    doneQuery = v
  action toggleFold(col: string)
    foldedCols = folded(foldedCols, col) ? foldedCols.split(" ").filter(x => x != col and x != "").join(" ") : (foldedCols + " " + col).trim()
  action toggleCompleted
    showCompleted = not showCompleted
  action toggleListView
    if openList != "" and not pending(boardsSaved)
      send boardsSaved = setListView(openList, listView == "list" ? "board" : "list")
  action toggleTask(id: string, done: bool)
    send taskToggled = setTaskDoneIn(id, done, doneSectionId == "" ? "" : done ? doneSectionId : tasks.tasks.filter(x => x.id == id and x.sectionId == doneSectionId).length > 0 ? "-" : "")
  // Task context menu: contextmenu on a row sets ctxTask, then one popover (`task-menu`) serves every row.
  action toggleGroup(g: string)
    if folded(openGroups, g)
      openGroups = openGroups.split(" ").filter(x => x != g).join(" ")
    else
      openGroups = (openGroups + " " + g).trim()
  action openTaskMenu(id: string)
    ctxTask = id
    openGroups = ""
  action ctxDone
    toggleTask(ctxTask, not ctxRow.isDone)
  action ctxFlag
    send taskPatched = patchTask(ctxTask, not ctxRow.flagged, ctxRow.priority)
  action ctxPriority(p: number)
    send taskPatched = patchTask(ctxTask, ctxRow.flagged, p)
  // Move to another section of the open list ("" = Uncategorized), or to another list (lands in its Uncategorized).
  action ctxMoveSection(sectionId: string)
    send taskDropped = placeTask(openList, ctxTask, sectionId, "", doneSectionId == "" ? "" : sectionId == doneSectionId ? "done" : "open")
  action ctxMoveList(listId: string)
    send taskMoved = moveTask(ctxTask, listId, "")
  action ctxAssign(assigneeId: string)
    send taskAssigned = assignTask(ctxTask, assigneeId)
  action openNoteMenu(id: string)
    ctxNote = id
    openGroups = ""
  action ctxNotePin
    send notePatched = patchNote(ctxNote, not ctxNoteRow.isPinned, ctxNoteRow.tags, ctxNoteRow.folder)
  action ctxNoteVault
    send notePatched = patchNote(ctxNote, ctxNoteRow.isPinned, ctxNoteRow.tags.includes("vault") ? ctxNoteRow.tags.filter(t => t != "vault") : ctxNoteRow.tags.concat(["vault"]), ctxNoteRow.folder)
  action ctxNoteFolder(f: string)
    send notePatched = patchNote(ctxNote, ctxNoteRow.isPinned, ctxNoteRow.tags, f)
  action ctxNoteTrash
    send noteFate = trashNote(ctxNote)
  action openEventMenu(id: string)
    ctxEvent = id
  action ctxEventOpen
    nav = push(nav, path("eventDetail", ctxEvent))
  action ctxEventDelete
    send ctxEventDeleted = deleteEvent(ctxEvent)
  action openListMenu(id: string)
    ctxList = id
  action ctxListOpen
    openSideList(ctxList)
  action ctxListNewTask
    openNewTaskIn(ctxList)
  action ctxListEdit
    openEditList(ctxList)
  action ctxListAsk
    showModal("delete-list-ctx")
  action ctxListDelete
    send listDeleted = deleteList(ctxList)
  action openSectionMenu(id: string)
    ctxSection = id
  action ctxSectionFold
    if listView == "board"
      toggleShutCol(ctxSection)
    else
      toggleFold(ctxSection)
  action ctxSectionAdd
    openBoardAdd(ctxSection)
  action ctxListShare
    openShareList(ctxList)
  action openCalMenu(id: string)
    ctxCal = id
  action ctxCalToggle
    toggleCalVisible(ctxCal, not ctxCalRow.isActive)
  action ctxCalEdit
    openCalEdit(ctxCal, ctxCalRow.name, ctxCalRow.color)
  action ctxDelete
    showModal("delete-task-ctx")
  action ctxDeleteNow
    send ctxDeleted = deleteTask(ctxTask)
  action openNewEvent
    if wide
      openSheet("newEvent", "")
    else
      nav = push(nav, "/new-event")
  // One save for the editor: a new event (id "") is one POST with every field, an edit one PATCH.
  action saveEvent(id: string, cal: string, title: string, notes: string, url: string, location: string, allDay: bool, startDay: string, startTime: string, endDay: string, endTime: string, repeat: string, alert: string, attendees: string[])
    if title.trim() != "" and id == "" and cal != "" and not pending(eventAdded)
      send eventAdded = createEvent(cal, title, notes, url, location, allDay, startDay, startTime, endDay, endTime, repeat, alert, attendees)
    else if title.trim() != "" and id != "" and not pending(eventSaved)
      send eventSaved = updateEvent(id, title, notes, url, location, allDay, startDay, startTime, endDay, endTime, repeat, alert, attendees)
  action afterEventAdd
    if eventError == "" and sheet == "newEvent"
      closeSheet()
    if eventError == "" and top(nav).name == "newEvent"
      nav = back(nav)
  action prevPeriod
    periodOffset = periodOffset - 1
    selectedDay = ""
  action nextPeriod
    periodOffset = periodOffset + 1
    selectedDay = ""
  action thisPeriod
    periodOffset = 0
    anchorDay = ""
    selectedDay = ""
  // The calendar button always heads for today: away from it, back to today (same view); already on today, out to the month;
  // already on this month, nothing.
  derive onToday = (anchorDay == "" or anchorDay == today) and periodOffset == 0 and (selectedDay == "" or selectedDay == today)
  action todayButton
    if not onToday
      thisPeriod()
    else if calMode != "month"
      pickMode("month")
  action openBoardCol(col: string)
    if wide
      if not folded(openedCols, col)
        openedCols = (openedCols + " " + col).trim()
      shutCols = shutCols.split(" ").filter(c => c != col).join(" ")
    else
      boardActive = col
  action toggleShutCol(col: string)
    if folded(shutCols, col)
      shutCols = shutCols.split(" ").filter(c => c != col).join(" ")
    else
      shutCols = (shutCols + " " + col).trim()
  action openBoardAdd(col: string)
    openBoardCol(col)
    openSectionAdd(col)
  action pickMode(v: string)
    calMode = v
    periodOffset = 0
    selectedDay = ""
  action selectDay(day: string)
    selectedDay = day
  action openDay(day: string)
    anchorDay = day
    calMode = "day"
    periodOffset = 0
    selectedDay = ""
  action editCalDraft(v: string)
    calDraft = v
  action createCalendarNow
    if calDraft.trim() != "" and not pending(calendarCreated)
      send calendarCreated = createCalendar(calDraft.trim())
  action openNewCalendar
    hidePopover("cal-menu-pop")
    showPopover("new-calendar-pop")
  // Subscriptions: an ICS link, or a CalDAV account whose calendars are found first and then picked.
  state subPicked = ""
  derive subscribeError = match calendarSubscribed { case some(r) => r.error, case none => "" }
  derive discovery = match caldavFound { case some(d) => d, case none => Discovery(ok=true, error="", found=[]) }
  derive connectError = match caldavConnected { case some(r) => r.error, case none => "" }
  derive syncMessage = match calendarSynced { case some(r) => r.error, case none => "" }
  action openAddCalendar
    subPicked = ""
    if wide
      sheetBack = sheet
      openSheet("addCalendar", "")
    else
      nav = push(nav, "/add-calendar")
  action subscribeNow(url: string, name: string, username: string, password: string)
    if url.trim() != "" and not pending(calendarSubscribed)
      send calendarSubscribed = subscribeCalendar(url.trim(), name.trim(), username, password)
  action findCaldav(url: string, username: string, password: string)
    if url.trim() != "" and username != "" and password != "" and not pending(caldavFound)
      subPicked = ""
      send caldavFound = discoverCaldav(url.trim(), username, password)
  action toggleFound(u: string, on: bool)
    let rest = subPicked.split("\n").filter(x => x != "" and x != u)
    subPicked = (on ? rest.concat([u]) : rest).join("\n")
  action connectNow(url: string, username: string, password: string)
    if subPicked != "" and not pending(caldavConnected)
      send caldavConnected = connectCaldav(url.trim(), username, password, subPicked)
  action afterSubscribe
    if sheet == "addCalendar" and subscribeError == "" and connectError == ""
      closeSheet()
    if top(nav).name == "addCalendar" and subscribeError == "" and connectError == ""
      nav = back(nav)
  action syncNow(id: string)
    if not pending(calendarSynced)
      send calendarSynced = syncCalendar(id)
  action openManageCalendars
    calEditId = ""
    if wide
      openSheet("manageCalendars", "")
    else
      nav = push(nav, "/manage-calendars")
  action afterCalendarCreate
    if calendarError == ""
      calDraft = ""
      hidePopover("new-calendar-pop")
  // Visibility is a full PATCH too: the calendar's name and color go back unchanged.
  action toggleCalVisible(id: string, on: bool)
    let c = calOf(calendars.calendars, id)
    send calendarToggled = updateCalendar(id, c.name, c.color, on)
  action openCalEdit(id: string, name: string, color: string)
    calEditId = calEditId == id ? "" : id
    calEditName = name
    calEditColor = color
  action editCalName(v: string)
    calEditName = v
  action pickCalColor(hex: string)
    calEditColor = hex
  action saveCalNow
    if calEditName.trim() != "" and calEditId != "" and not pending(calendarSaved)
      send calendarSaved = updateCalendar(calEditId, calEditName.trim(), calEditColor, calOf(calendars.calendars, calEditId).isActive)
  action afterCalendarSave
    if calendarSaveError == ""
      calEditId = ""
  action askDeleteCal
    showModal("delete-calendar")
  action removeCalNow
    send calendarDeleted = deleteCalendar(calEditId)
  action afterCalendarDelete
    if calendarDeleteError == ""
      calEditId = ""
  action afterEventSave
    if eventSaveError == "" and sheet == "event"
      closeSheet()
    if eventSaveError == "" and top(nav).name == "eventDetail"
      nav = back(nav)
  action afterEventDelete
    if sheet == "event"
      closeSheet()
    if top(nav).name == "eventDetail"
      nav = back(nav)
  action askDeleteEvent
    showModal("delete-event")
  action removeEventNow
    send eventDeleted = deleteEvent(openEvent)
    if sheet == "event"
      closeSheet()
    if top(nav).name == "eventDetail"
      nav = back(nav)

  view
    main viewport-fit="cover" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow resize=onWinResize dragenter=dropEntered dragleave=dropLeft drop=filesDropped testId="app" width="100%" height="100%" interactive-widget="resizes-content" position="relative"
      display="flex" flex-direction=(wide and session.signedIn ? "row" : "column")
