            if nav.tab == "tasks"
              button press=crumbHome appearance="none" pointer-events="auto" testId="crumb-section" padding="2px 8px" border-radius=6 background-color=(crumbOnList ? "transparent" : "light-dark(#e3ecfb, #2a3a55)")
                text "Tasks" color="AccentColor" font="-exact-subheadline"
              if crumbOnList
