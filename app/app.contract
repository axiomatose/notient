  action openNewNote
    noteChromeHidden = false
    noteLastY = 0
    editorNoteId = ""
    editorTitle = ""
    editorBody = ""
    editorFolder = ""
    editorTagsText = ""
    editorPinned = false
    savedTitle = ""
    savedBody = ""
    savedFolder = ""
    savedTags = ""
    savedPinned = false
    editorMode = "edit"
    lastEdit = performanceNow()
    nav = wide ? open(nav, "/new") : push(nav, "/new")
  action startNote(close: bool)
    if editorNoteId == "" and not pending(noteStarted) and (editorTitle.trim() != "" or editorBody.trim() != "")
      closeOnCreate = close
      send noteStarted = createNoteDraft(draftTitle, editorBody, editorFolder, editorTagsList, editorPinned)
  action adoptNote
    match noteStarted
      case some(r)
        if r.ok
          editorNoteId = r.id
          savedTitle = r.title
          savedBody = r.body
          if editorTitle.trim() == ""
            editorTitle = r.title
            savedTitle = r.title
          if closeOnCreate and top(nav).name == "newNote"
            nav = back(nav)
        else
          closeOnCreate = false
      case none
        closeOnCreate = false
