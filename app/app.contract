                      button press=toggleListView popovertarget="list-menu-pop" popovertargetaction="hide" testId="menu-view-toggle"
                        text (listView == "list" ? "Board view" : "List view")
                      if sectionsSame and sections.sections.length > 1
                        button press=openSectionOrder testId="menu-reorder-sections"
                          text "Reorder sections"
                      button press=saveListAsTemplate popovertarget="list-menu-pop" popovertargetaction="hide" testId="list-save-template"
                        text "Save as template"
                      button press=openShareList(e.params.id) popovertarget="list-menu-pop" popovertargetaction="hide" testId="list-share"
