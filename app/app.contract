                      button press=openEditList(e.params.id) popovertarget="list-menu-pop" popovertargetaction="hide" testId="list-edit"
                        text "Edit"
                    column id="task-menu" popover="auto" role="menu" aria-label="Task options" padding=8 gap=4 background-color="light-dark(#ffffff, #2c2c2e)" border-radius=14 box-shadow="0 8px 28px #00000040" min-width="15rem" testId="task-menu"
                      button press=openTaskDetail(ctxTask) popovertarget="task-menu" popovertargetaction="hide" testId="ctx-open"
                        text "Open Task"
                      button press=ctxDone popovertarget="task-menu" popovertargetaction="hide" testId="ctx-done"
                        text (ctxRow.isDone ? "Mark Not Done" : "Mark Done")
                      button press=ctxFlag popovertarget="task-menu" popovertargetaction="hide" testId="ctx-flag"
                        text (ctxRow.flagged ? "Unflag" : "Flag")
                      hr
                      column role="group" aria-label="Priority"
                        button press=toggleGroup("prio") role="menuitem" aria-expanded=folded(openGroups, "prio") aria-label="Priority" testId="grp-prio"
                          row gap=8 align-items="center" width="100%"
                            text "Priority" flex=1 min-width=0 text-align="start"
                            text (ctxRow.priority == 0 ? "None" : ctxRow.priority == 1 ? "Low" : ctxRow.priority == 2 ? "Medium" : "High") color="-exact-secondary-label" font="-exact-footnote" line-clamp=1
                            image (folded(openGroups, "prio") ? "symbol:minus" : "symbol:add")
                        if folded(openGroups, "prio")
                          button press=ctxPriority(0) aria-checked=(ctxRow.priority == 0) popovertarget="task-menu" popovertargetaction="hide" testId="ctx-priority-0"
