                                column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                  text sl.name
                                  text `Shared by ${sl.sharedBy}` font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
                                image "symbol:forward-chevron"
                    column id="new-folder-pop" popover="auto" padding=8 gap=4 width="17.5rem" testId="new-folder-pop"
                      row gap=8 align-items="center"
                        column flex=1 min-width=0 gap=4
                          input value=folderDraft input=editFolderDraft submit=addFolder placeholder="New folder for lists" appearance="none" outline="none"
                            aria-label="New folder" autofocus=true testId="folder-draft"
                          if folderError != "" and not pending(folderAdded)
                            text folderError font="-exact-footnote" color="-exact-system-red" testId="folder-error"
                        button press=addFolder disabled=(folderDraft.trim() == "") testId="add-folder"
                          text "Add"
                    if listsSame and lists.lists.length > 0
                      button press=openNewTask aria-label="Add task" testId="fab-add-task" position="absolute" right=20 bottom=20 width=56 height=56 border-radius=28 background-color="AccentColor" color="AccentColorText" display="flex" align-items="center" justify-content="center" box-shadow="0 4px 12px #0000003d"
                        image "symbol:add" width=26 height=26
              if e.name == "taskList"
                if tasks.owner == session.email and tasks.listId == e.params.id
                  column navigationKey=`${e.id}` navigationBar=(wide ? "none" : "auto") box-sizing="border-box" padding-top=(wide ? 44 : 0) navigationScroll=`content-${e.id}` position="absolute" inset=0
                    display="flex" flex-direction="column"
                    header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding=(wide ? "8px 12px 0" : "8px 16px") position=(wide ? "absolute" : "relative") top=0 right=0 z-index=(wide ? 11 : 0) box-sizing="border-box" border-bottom="none"
                      row gap=6 align-items="center" flex="1 1 8rem" min-width=0
                        if not wide
