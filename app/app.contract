  // The modal's TaskEditor passes its id ("" while creating); the new task has none yet.
  action createNewTask(id: string, title: string, notes: string, url: string, dueDay: string, dueTime: string, reminder: string, recurrence: string, flagged: bool, priority: number, tags: string[], listId: string, sectionId: string)
    if title.trim() != "" and listId != "" and not pending(newTaskAdded)
      send newTaskAdded = createTaskFull(listId, sectionId, title.trim(), notes, url, dueDay, dueTime, reminder, recurrence, flagged, priority, tags)
  action afterNewTaskAdd
    if newTaskError == "" and sheet == "newTask"
      closeSheet()
    if newTaskError == "" and top(nav).name == "newTask"
      nav = back(nav)
  action saveTask(id: string, title: string, notes: string, url: string, dueDay: string, dueTime: string, reminder: string, recurrence: string, flagged: bool, priority: number, tags: string[], listId: string, sectionId: string)
    if title.trim() != ""
      send taskSaved = updateTask(id, title.trim(), notes, url, dueDay, dueTime, reminder, recurrence, flagged, priority, tags, listId, sectionId)
      // The task moved to another list: it no longer belongs to this list's screen.
      if listId != openList and top(nav).name == "taskDetail"
        nav = back(nav)
      if listId != openList
        drawerTask = ""
  // The sheet's Save saves and closes it (the image picker saves too, but keeps the sheet).
  state closeTaskOnSave = false
  action saveTaskClose(id: string, title: string, notes: string, url: string, dueDay: string, dueTime: string, reminder: string, recurrence: string, flagged: bool, priority: number, tags: string[], listId: string, sectionId: string)
    if title.trim() != "" and not pending(taskSaved)
      closeTaskOnSave = true
      saveTask(id, title, notes, url, dueDay, dueTime, reminder, recurrence, flagged, priority, tags, listId, sectionId)
  action afterTaskSaved
    if closeTaskOnSave
      closeTaskOnSave = false
      if taskSaveError == ""
        drawerTask = ""
      if taskSaveError == "" and top(nav).name == "taskDetail"
        nav = back(nav)
  action askDeleteTask
    showModal("delete-task")
  action removeTaskNow
    send taskDeleted = deleteTask(selectedTask)
    drawerTask = ""
    if top(nav).name == "taskDetail"
      nav = back(nav)
  action addSubtask(listId: string, parentId: string, draft: string)
