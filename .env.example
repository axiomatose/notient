# Docker Compose reads this file (copy to .env). It sets what docker-compose-example.yml passes to
# the API; see server/.env.example for every setting and what it does.

JWT_SECRET=change-me
ENCRYPTION_MASTER_KEY=change-me-to-32-or-more-random-characters

# Public address of the server and the port it listens on.
PUBLIC_URL=https://notes.example.com
CORS_ORIGINS=https://notes.example.com
API_PORT=3301

# Optional: web push (npm run vapid-generate in server/).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
